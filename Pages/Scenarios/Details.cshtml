@page "{id:int}"
@model EmergentEngineering.Pages.Scenarios.DetailsModel
@{
    ViewData["Title"] = Model.Scenario?.Name ?? "繧ｷ繝翫Μ繧ｪ隧ｳ邏ｰ";
}

@if (Model.Scenario is null)
{
    <div class="alert alert-warning">繧ｷ繝翫Μ繧ｪ縺瑚ｦ九▽縺九ｊ縺ｾ縺帙ｓ縲・</div>
    return;
}

<div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
        <a asp-page="/Scenarios/Index" class="text-decoration-none small">&larr; 繧ｷ繝翫Μ繧ｪ荳隕ｧ</a>
        <h1 class="h2 mt-2 mb-1">@Model.Scenario.Name</h1>
        <div class="text-muted">@Model.Scenario.Description</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-page="/Experiments/Create" asp-route-scenarioId="@Model.Scenario.Id">縺薙・繧ｷ繝翫Μ繧ｪ縺九ｉ螳滄ｨ薙ｒ菴懈・</a>
        <a class="btn btn-outline-secondary" asp-page="/Scenarios/Edit" asp-route-id="@Model.Scenario.Id">邱ｨ髮・</a>
        <a class="btn btn-outline-danger" asp-page="/Scenarios/Delete" asp-route-id="@Model.Scenario.Id">蜑企勁</a>
    </div>
</div>

<section class="summary-grid mb-4">
    <div>
        <h2 class="h6">逶ｮ逧・</h2>
        <p>@Model.Scenario.Purpose</p>
    </div>
    <div>
        <h2 class="h6">蠅・阜譚｡莉ｶ</h2>
        <p>@Model.Scenario.BoundaryConditions</p>
    </div>
    <div>
        <h2 class="h6">KPI</h2>
        <p>@Model.Scenario.KpiDefinition</p>
    </div>
    <div>
        <h2 class="h6">Agent謨ｰ</h2>
        <p>@Model.Scenario.AgentCount</p>
    </div>
    <div>
        <h2 class="h6">Step謨ｰ</h2>
        <p>@Model.Scenario.TotalSteps</p>
    </div>
    <div>
        <h2 class="h6">Run蝗樊焚</h2>
        <p>@Model.Scenario.RunCount</p>
    </div>
    <div>
        <h2 class="h6">LLM繝励Ο繝舌う繝繝ｼ</h2>
        <p>@Model.Scenario.LlmProvider</p>
    </div>
    <div>
        <h2 class="h6">LLM繝｢繝・Ν</h2>
        <p>@Model.Scenario.LlmModel</p>
    </div>
    <div>
        <h2 class="h6">蜿ら・Experiment謨ｰ</h2>
        <p>@Model.ExperimentCount</p>
    </div>
</section>

<section class="log-section">
    <h2 class="h5 mb-3">蠅・阜譚｡莉ｶ繝代Λ繝｡繝ｼ繧ｿ</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <tbody>
                <tr><th>諠・ｱ蜈ｱ譛・</th><td>@Model.Scenario.InformationSharingLevel.ToString("0.0")</td></tr>
                <tr><th>蜊碑ｪｿ諤ｧ</th><td>@Model.Scenario.CooperationLevel.ToString("0.0")</td></tr>
                <tr><th>遶ｶ莠画ｧ</th><td>@Model.Scenario.CompetitionLevel.ToString("0.0")</td></tr>
                <tr><th>蠢・炊逧・ｮ牙・諤ｧ</th><td>@Model.Scenario.PsychologicalSafetyLevel.ToString("0.0")</td></tr>
                <tr><th>蟄ｦ鄙貞ｿ怜髄</th><td>@Model.Scenario.LearningOrientationLevel.ToString("0.0")</td></tr>
                <tr><th>鬘ｧ螳｢蠢怜髄</th><td>@Model.Scenario.CustomerOrientationLevel.ToString("0.0")</td></tr>
                <tr><th>遏ｭ譛滓・譫懷悸蜉・</th><td>@Model.Scenario.ShortTermResultPressureLevel.ToString("0.0")</td></tr>
                <tr><th>螳溷柑菫｡鬆ｼ髢ｾ蛟､</th><td>@Model.Scenario.EffectiveTrustThreshold.ToString("0.00")</td></tr>
                <tr><th>知識蓄積</th><td>@Model.Scenario.KnowledgeStock.ToString("0.00")</td></tr>
                <tr><th>知識多様性</th><td>@Model.Scenario.KnowledgeDiversity.ToString("0.00")</td></tr>
                <tr><th>外部刺激レベル</th><td>@Model.Scenario.ExternalShockLevel.ToString("0.00")</td></tr>
                <tr><th>異分野接触度</th><td>@Model.Scenario.CrossDomainExposure.ToString("0.00")</td></tr>
                <tr><th>再配線感度</th><td>@Model.Scenario.RewiringSensitivity.ToString("0.00")</td></tr>
                <tr><th>外部刺激を有効化</th><td>@(Model.Scenario.EnableExternalShock ? "Yes" : "No")</td></tr>
                <tr><th>外部刺激Step</th><td>@Model.Scenario.ShockStep</td></tr>
                <tr><th>外部刺激タイプ</th><td>@Model.Scenario.ShockType</td></tr>
                <tr><th>外部刺激説明</th><td>@(string.IsNullOrWhiteSpace(Model.Scenario.ShockDescription) ? "-" : Model.Scenario.ShockDescription)</td></tr>
            </tbody>
        </table>
    </div>
</section>


