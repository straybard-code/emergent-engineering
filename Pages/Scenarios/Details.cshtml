@page "{id:int}"
@model EmergentEngineering.Pages.Scenarios.DetailsModel
@{
    ViewData["Title"] = Model.Scenario?.Name ?? "シナリオ詳細";
}

@functions {
    private static string FormatBoolJapanese(bool value) => value ? "有効" : "無効";
    private static string FormatValue(double value) => value.ToString("0.000");
}

@if (Model.Scenario is null)
{
    <div class="alert alert-warning">シナリオが見つかりません。</div>
    return;
}

<div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
        <a asp-page="/Scenarios/Index" class="text-decoration-none small">&larr; シナリオ一覧</a>
        <h1 class="h2 mt-2 mb-1">@Model.Scenario.Name</h1>
        <div class="text-muted">@Model.Scenario.Description</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-page="/Experiments/Create" asp-route-scenarioId="@Model.Scenario.Id">このシナリオから実験を作成</a>
        <a class="btn btn-outline-success" asp-page="/Scenarios/Create" asp-route-sourceScenarioId="@Model.Scenario.Id">コピー</a>
        <a class="btn btn-outline-secondary" asp-page="/Scenarios/Edit" asp-route-id="@Model.Scenario.Id">編集</a>
        <a class="btn btn-outline-danger" asp-page="/Scenarios/Delete" asp-route-id="@Model.Scenario.Id">削除</a>
    </div>
</div>

<section class="summary-grid mb-4">
    <div>
        <h2 class="h6">目的</h2>
        <p>@Model.Scenario.Purpose</p>
    </div>
    <div>
        <h2 class="h6">境界条件</h2>
        <p>@Model.Scenario.BoundaryConditions</p>
    </div>
    <div>
        <h2 class="h6">KPI</h2>
        <p>@Model.Scenario.KpiDefinition</p>
    </div>
    <div>
        <h2 class="h6">Agent数</h2>
        <p>@Model.Scenario.AgentCount</p>
    </div>
    <div>
        <h2 class="h6">Step数</h2>
        <p>@Model.Scenario.TotalSteps</p>
    </div>
    <div>
        <h2 class="h6">Run数</h2>
        <p>@Model.Scenario.RunCount</p>
    </div>
    <div>
        <h2 class="h6">LLMプロバイダー</h2>
        <p>@Model.Scenario.LlmProvider</p>
    </div>
    <div>
        <h2 class="h6">LLMモデル</h2>
        <p>@Model.Scenario.LlmModel</p>
    </div>
    <div>
        <h2 class="h6">関連Experiment数</h2>
        <p>@Model.ExperimentCount</p>
    </div>
</section>

<section class="log-section mt-4">
    <h2 class="h5 mb-3">Thanks Coin / 相互敬意</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <tbody>
                <tr><th>Thanks Coin 有効</th><td>@FormatBoolJapanese(Model.Scenario.EnableThanksCoin)</td></tr>
                <tr><th>Thanks Coin 発生率</th><td>@FormatValue(Model.Scenario.ThanksCoinRate)</td></tr>
                <tr><th>敬意増加量</th><td>@FormatValue(Model.Scenario.ThanksCoinRespectGain)</td></tr>
                <tr><th>信頼増加量</th><td>@FormatValue(Model.Scenario.ThanksCoinTrustGain)</td></tr>
                <tr><th>知識再構成増加量</th><td>@FormatValue(Model.Scenario.ThanksCoinReconfigurationGain)</td></tr>
                <tr><th>心理的安全性増加量</th><td>@FormatValue(Model.Scenario.ThanksCoinPsychologicalSafetyGain)</td></tr>
                <tr><th>橋渡し増加量</th><td>@FormatValue(Model.Scenario.ThanksCoinBridgeGain)</td></tr>
                <tr><th>人気集中バイアス</th><td>@FormatValue(Model.Scenario.ThanksCoinPopularityBias)</td></tr>
                <tr><th>多様性ボーナス</th><td>@FormatValue(Model.Scenario.ThanksCoinDiversityBonus)</td></tr>
                <tr><th>建設的異論ボーナス</th><td>@FormatValue(Model.Scenario.ThanksCoinChallengeBonus)</td></tr>
            </tbody>
        </table>
    </div>
</section>

<section class="log-section mt-4">
    <h2 class="h5 mb-3">相互敬意</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <tbody>
                <tr><th>相互敬意ベース</th><td>@FormatValue(Model.Scenario.MutualRespectBase)</td></tr>
                <tr><th>相互敬意成長率</th><td>@FormatValue(Model.Scenario.MutualRespectGrowthRate)</td></tr>
                <tr><th>相互敬意減衰率</th><td>@FormatValue(Model.Scenario.MutualRespectDecayRate)</td></tr>
                <tr><th>異質性尊重感度</th><td>@FormatValue(Model.Scenario.MutualRespectDiversitySensitivity)</td></tr>
                <tr><th>異論尊重感度</th><td>@FormatValue(Model.Scenario.MutualRespectChallengeSensitivity)</td></tr>
                <tr><th>橋渡し尊重感度</th><td>@FormatValue(Model.Scenario.MutualRespectBridgeSensitivity)</td></tr>
                <tr><th>人気集中ペナルティ</th><td>@FormatValue(Model.Scenario.MutualRespectPopularityPenalty)</td></tr>
            </tbody>
        </table>
    </div>
</section>

<section class="log-section mt-4">
    <h2 class="h5 mb-3">知的敬意 / Mutual Mentorship</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <tbody>
                <tr><th>知的敬意 有効</th><td>@FormatBoolJapanese(Model.Scenario.EnableIntellectualRespect)</td></tr>
                <tr><th>知的敬意ベース</th><td>@FormatValue(Model.Scenario.IntellectualRespectBase)</td></tr>
                <tr><th>知的敬意成長率</th><td>@FormatValue(Model.Scenario.IntellectualRespectGrowthRate)</td></tr>
                <tr><th>知的敬意減衰率</th><td>@FormatValue(Model.Scenario.IntellectualRespectDecayRate)</td></tr>
                <tr><th>異質知識尊重感度</th><td>@FormatValue(Model.Scenario.IntellectualRespectDiversitySensitivity)</td></tr>
                <tr><th>異論知的敬意感度</th><td>@FormatValue(Model.Scenario.IntellectualRespectChallengeSensitivity)</td></tr>
                <tr><th>師匠化感度</th><td>@FormatValue(Model.Scenario.IntellectualRespectMentorshipSensitivity)</td></tr>
                <tr><th>自尊心ペナルティ</th><td>@FormatValue(Model.Scenario.IntellectualRespectEgoPenalty)</td></tr>
                <tr><th>序列ペナルティ</th><td>@FormatValue(Model.Scenario.IntellectualRespectHierarchyPenalty)</td></tr>
            </tbody>
        </table>
    </div>
</section>

<section class="log-section">
    <h2 class="h5 mb-3">境界条件パラメータ</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <tbody>
                <tr><th>情報共有</th><td>@Model.Scenario.InformationSharingLevel.ToString("0.00")</td></tr>
                <tr><th>協調性</th><td>@Model.Scenario.CooperationLevel.ToString("0.00")</td></tr>
                <tr><th>競争性</th><td>@Model.Scenario.CompetitionLevel.ToString("0.00")</td></tr>
                <tr><th>心理的安全性</th><td>@Model.Scenario.PsychologicalSafetyLevel.ToString("0.00")</td></tr>
                <tr><th>学習志向</th><td>@Model.Scenario.LearningOrientationLevel.ToString("0.00")</td></tr>
                <tr><th>顧客志向</th><td>@Model.Scenario.CustomerOrientationLevel.ToString("0.00")</td></tr>
                <tr><th>短期成果圧力</th><td>@Model.Scenario.ShortTermResultPressureLevel.ToString("0.00")</td></tr>
                <tr><th>実効信頼閾値</th><td>@Model.Scenario.EffectiveTrustThreshold.ToString("0.00")</td></tr>
                <tr><th>知識蓄積</th><td>@Model.Scenario.KnowledgeStock.ToString("0.00")</td></tr>
                <tr><th>知識多様性</th><td>@Model.Scenario.KnowledgeDiversity.ToString("0.00")</td></tr>
                <tr><th>外部刺激レベル</th><td>@Model.Scenario.ExternalShockLevel.ToString("0.00")</td></tr>
                <tr><th>異分野接触度</th><td>@Model.Scenario.CrossDomainExposure.ToString("0.00")</td></tr>
                <tr><th>再配線感度</th><td>@Model.Scenario.RewiringSensitivity.ToString("0.00")</td></tr>
                <tr><th>外部刺激を有効化</th><td>@(Model.Scenario.EnableExternalShock ? "Yes" : "No")</td></tr>
                <tr><th>外部刺激 Step</th><td>@Model.Scenario.ShockStep</td></tr>
                <tr><th>外部刺激タイプ</th><td>@Model.Scenario.ShockType</td></tr>
                <tr><th>外部刺激説明</th><td>@(string.IsNullOrWhiteSpace(Model.Scenario.ShockDescription) ? "-" : Model.Scenario.ShockDescription)</td></tr>
                <tr><th>Challenge を有効化</th><td>@(Model.Scenario.EnableChallengeEvent ? "Yes" : "No")</td></tr>
                <tr><th>Challenge 発生 Step</th><td>@Model.Scenario.ChallengeStep</td></tr>
                <tr><th>Challenge タイプ</th><td>@Model.Scenario.ChallengeType</td></tr>
                <tr><th>Challenge レベル</th><td>@Model.Scenario.ChallengeLevel.ToString("0.00")</td></tr>
                <tr><th>Challenge 説明</th><td>@(string.IsNullOrWhiteSpace(Model.Scenario.ChallengeDescription) ? "-" : Model.Scenario.ChallengeDescription)</td></tr>
                <tr><th>必要知識多様性</th><td>@Model.Scenario.RequiredKnowledgeDiversity.ToString("0.00")</td></tr>
                <tr><th>必要異分野接触度</th><td>@Model.Scenario.RequiredCrossDomainExposure.ToString("0.00")</td></tr>
                <tr><th>必要再配線スコア</th><td>@Model.Scenario.RequiredRewiringScore.ToString("0.00")</td></tr>
                <tr><th>探索傾向</th><td>@Model.Scenario.ExplorationTendency.ToString("0.00")</td></tr>
                <tr><th>セレンディピティ感受性</th><td>@Model.Scenario.SerendipitySensitivity.ToString("0.00")</td></tr>
                <tr><th>知識再結合率</th><td>@Model.Scenario.KnowledgeRecombinationRate.ToString("0.00")</td></tr>
                <tr><th>セレンディピティ閾値</th><td>@Model.Scenario.SerendipityThreshold.ToString("0.00")</td></tr>
                <tr><th>セレンディピティを有効化</th><td>@(Model.Scenario.EnableSerendipity ? "Yes" : "No")</td></tr>
                <tr><th>Trust Dynamics を有効化</th><td>@(Model.Scenario.EnableTrustDynamics ? "Yes" : "No")</td></tr>
                <tr><th>信頼成長率</th><td>@Model.Scenario.TrustGrowthRate.ToString("0.00")</td></tr>
                <tr><th>信頼自然減衰率</th><td>@Model.Scenario.TrustDecayRate.ToString("0.00")</td></tr>
                <tr><th>信頼飽和強度</th><td>@Model.Scenario.TrustSaturationStrength.ToString("0.00")</td></tr>
                <tr><th>信頼容量</th><td>@Model.Scenario.TrustCapacity</td></tr>
                <tr><th>信頼容量ペナルティ</th><td>@Model.Scenario.TrustCapacityPenalty.ToString("0.00")</td></tr>
                <tr><th>不信ペナルティ</th><td>@Model.Scenario.DistrustPenalty.ToString("0.00")</td></tr>
                <tr><th>建設的批判ボーナス</th><td>@Model.Scenario.ConstructiveCriticismBonus.ToString("0.00")</td></tr>
            </tbody>
        </table>
    </div>
</section>
