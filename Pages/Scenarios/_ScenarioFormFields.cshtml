@model EmergentEngineering.Models.Scenario

<div class="mb-3">
    <label asp-for="Name" class="form-label">シナリオ名</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

@if (ViewData["ShowResearchPreset"] is bool showResearchPreset && showResearchPreset)
{
    <partial name="_ResearchPresetPanel" />
}

<div class="mb-3">
    <label asp-for="Description" class="form-label">説明</label>
    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Purpose" class="form-label">目的</label>
    <textarea asp-for="Purpose" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Purpose" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="BoundaryConditions" class="form-label">境界条件</label>
    <textarea asp-for="BoundaryConditions" class="form-control" rows="4"></textarea>
    <span asp-validation-for="BoundaryConditions" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="KpiDefinition" class="form-label">KPI</label>
    <textarea asp-for="KpiDefinition" class="form-control" rows="3"></textarea>
    <span asp-validation-for="KpiDefinition" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="LlmProvider" class="form-label">LLMプロバイダー</label>
        <select asp-for="LlmProvider" class="form-select">
            <option value="Mock">Mock（高速・無料）</option>
            <option value="OpenAI">OpenAI（高精度・有料）</option>
        </select>
        <span asp-validation-for="LlmProvider" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="LlmModel" class="form-label">LLMモデル</label>
        <select asp-for="LlmModel" class="form-select">
            <option value="mock-v1">mock-v1</option>
            <option value="gpt-4o-mini">gpt-4o-mini</option>
            <option value="gpt-4o">gpt-4o</option>
            <option value="gpt-5.5">gpt-5.5</option>
            <option value="gpt-5.6">gpt-5.6</option>
        </select>
        <span asp-validation-for="LlmModel" class="text-danger"></span>
    </div>
</div>

<section class="log-section mb-4 optional-settings" data-optional-section="external-shock">
    <h2 class="h5 mb-3">境界条件パラメータ</h2>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="InformationSharingLevel" class="form-label">情報共有</label>
            <input asp-for="InformationSharingLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="InformationSharingLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CooperationLevel" class="form-label">協調性</label>
            <input asp-for="CooperationLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="CooperationLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CompetitionLevel" class="form-label">競争性</label>
            <input asp-for="CompetitionLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="CompetitionLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PsychologicalSafetyLevel" class="form-label">心理的安全性</label>
            <input asp-for="PsychologicalSafetyLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="PsychologicalSafetyLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="LearningOrientationLevel" class="form-label">学習志向</label>
            <input asp-for="LearningOrientationLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="LearningOrientationLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CustomerOrientationLevel" class="form-label">顧客志向</label>
            <input asp-for="CustomerOrientationLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="CustomerOrientationLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ShortTermResultPressureLevel" class="form-label">短期成果圧力</label>
            <input asp-for="ShortTermResultPressureLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="ShortTermResultPressureLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EffectiveTrustThreshold" class="form-label">実効信頼閾値</label>
            <input asp-for="EffectiveTrustThreshold" class="form-control" type="number" min="0" max="1" step="0.01" />
            <div class="form-text">この値以上の Trust のみネットワーク接続として扱います。</div>
            <span asp-validation-for="EffectiveTrustThreshold" class="text-danger"></span>
        </div>
    </div>
</section>

<section class="log-section mb-4 optional-settings" data-optional-section="challenge">
    <h2 class="h5 mb-3">知識・再配線パラメータ</h2>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="KnowledgeStock" class="form-label">知識蓄積</label>
            <input asp-for="KnowledgeStock" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="KnowledgeStock" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="KnowledgeDiversity" class="form-label">知識多様性</label>
            <input asp-for="KnowledgeDiversity" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="KnowledgeDiversity" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ExternalShockLevel" class="form-label">外部刺激レベル</label>
            <input asp-for="ExternalShockLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="ExternalShockLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CrossDomainExposure" class="form-label">異分野接触度</label>
            <input asp-for="CrossDomainExposure" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="CrossDomainExposure" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="RewiringSensitivity" class="form-label">再配線感度</label>
            <input asp-for="RewiringSensitivity" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="RewiringSensitivity" class="text-danger"></span>
        </div>
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">外部刺激設定</h2>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="form-check mt-4">
                <input asp-for="EnableExternalShock" class="form-check-input" type="checkbox" />
                <label asp-for="EnableExternalShock" class="form-check-label">外部刺激を有効化</label>
            </div>
            <span asp-validation-for="EnableExternalShock" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ShockStep" class="form-label">外部刺激 Step</label>
            <input asp-for="ShockStep" class="form-control" type="number" min="0" max="100" step="1" />
            <span asp-validation-for="ShockStep" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ShockType" class="form-label">外部刺激タイプ</label>
            <select asp-for="ShockType" class="form-select">
                @foreach (var shockType in EmergentEngineering.Models.ShockTypes.All)
                {
                    <option value="@shockType">@shockType</option>
                }
            </select>
            <span asp-validation-for="ShockType" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ShockDescription" class="form-label">外部刺激説明</label>
            <input asp-for="ShockDescription" class="form-control" />
            <span asp-validation-for="ShockDescription" class="text-danger"></span>
        </div>
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Challenge 設定</h2>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="form-check mt-4">
                <input asp-for="EnableChallengeEvent" class="form-check-input" type="checkbox" />
                <label asp-for="EnableChallengeEvent" class="form-check-label">Challenge を有効化</label>
            </div>
            <span asp-validation-for="EnableChallengeEvent" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ChallengeStep" class="form-label">Challenge 発生 Step</label>
            <input asp-for="ChallengeStep" class="form-control" type="number" min="0" max="100" step="1" />
            <span asp-validation-for="ChallengeStep" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ChallengeType" class="form-label">Challenge タイプ</label>
            <select asp-for="ChallengeType" class="form-select">
                @foreach (var challengeType in EmergentEngineering.Models.ChallengeTypes.All)
                {
                    <option value="@challengeType">@challengeType</option>
                }
            </select>
            <span asp-validation-for="ChallengeType" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ChallengeLevel" class="form-label">Challenge レベル</label>
            <input asp-for="ChallengeLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="ChallengeLevel" class="text-danger"></span>
        </div>
        <div class="col-md-12 mb-3">
            <label asp-for="ChallengeDescription" class="form-label">Challenge 説明</label>
            <input asp-for="ChallengeDescription" class="form-control" />
            <span asp-validation-for="ChallengeDescription" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="RequiredKnowledgeDiversity" class="form-label">必要知識多様性</label>
            <input asp-for="RequiredKnowledgeDiversity" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="RequiredKnowledgeDiversity" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="RequiredCrossDomainExposure" class="form-label">必要異分野接触度</label>
            <input asp-for="RequiredCrossDomainExposure" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="RequiredCrossDomainExposure" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="RequiredRewiringScore" class="form-label">必要再配線スコア</label>
            <input asp-for="RequiredRewiringScore" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="RequiredRewiringScore" class="text-danger"></span>
        </div>
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">セレンディピティ設定</h2>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="form-check mt-4">
                <input asp-for="EnableSerendipity" class="form-check-input" type="checkbox" />
                <label asp-for="EnableSerendipity" class="form-check-label">セレンディピティを有効化</label>
            </div>
            <span asp-validation-for="EnableSerendipity" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="SerendipityThreshold" class="form-label">セレンディピティ閾値</label>
            <input asp-for="SerendipityThreshold" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="SerendipityThreshold" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ExplorationTendency" class="form-label">探索傾向</label>
            <input asp-for="ExplorationTendency" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="ExplorationTendency" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="SerendipitySensitivity" class="form-label">セレンディピティ感受性</label>
            <input asp-for="SerendipitySensitivity" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="SerendipitySensitivity" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="KnowledgeRecombinationRate" class="form-label">知識再結合率</label>
            <input asp-for="KnowledgeRecombinationRate" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="KnowledgeRecombinationRate" class="text-danger"></span>
        </div>
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">信頼ダイナミクス</h2>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="form-check mt-4">
                <input asp-for="EnableTrustDynamics" class="form-check-input" type="checkbox" />
                <label asp-for="EnableTrustDynamics" class="form-check-label">Trust Dynamics を有効化</label>
            </div>
            <span asp-validation-for="EnableTrustDynamics" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="TrustGrowthRate" class="form-label">信頼成長率</label>
            <input asp-for="TrustGrowthRate" class="form-control" type="number" min="0" max="2" step="0.01" />
            <span asp-validation-for="TrustGrowthRate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="TrustDecayRate" class="form-label">信頼自然減衰率</label>
            <input asp-for="TrustDecayRate" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="TrustDecayRate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="TrustSaturationStrength" class="form-label">信頼飽和強度</label>
            <input asp-for="TrustSaturationStrength" class="form-control" type="number" min="0" max="1" step="0.01" />
            <span asp-validation-for="TrustSaturationStrength" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="TrustCapacity" class="form-label">信頼容量</label>
            <input asp-for="TrustCapacity" class="form-control" type="number" min="1" max="20" step="1" />
            <span asp-validation-for="TrustCapacity" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="TrustCapacityPenalty" class="form-label">信頼容量ペナルティ</label>
            <input asp-for="TrustCapacityPenalty" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="TrustCapacityPenalty" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="DistrustPenalty" class="form-label">不信ペナルティ</label>
            <input asp-for="DistrustPenalty" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="DistrustPenalty" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ConstructiveCriticismBonus" class="form-label">建設的批判ボーナス</label>
            <input asp-for="ConstructiveCriticismBonus" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="ConstructiveCriticismBonus" class="text-danger"></span>
        </div>
    </div>
</section>

<partial name="_ExecutionScalePresetPanel" />

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="AgentCount" class="form-label">Agent数</label>
        <input asp-for="AgentCount" class="form-control" type="number" min="1" max="100" />
        <span asp-validation-for="AgentCount" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="TotalSteps" class="form-label">Step数</label>
        <input asp-for="TotalSteps" class="form-control" type="number" min="1" max="5000" />
        <span asp-validation-for="TotalSteps" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="RunCount" class="form-label">Run数</label>
        <input asp-for="RunCount" class="form-control" type="number" min="1" max="100" />
        <span asp-validation-for="RunCount" class="text-danger"></span>
    </div>
</div>

<partial name="_OptionalEventSectionScripts" />
