@page "{id:int}"
@model EmergentEngineering.Pages.Experiments.DetailsModel
@{
    ViewData["Title"] = Model.Experiment?.Name ?? "Experiment Details";
}

@functions {
    private static string FormatPhase(string? phase) => phase switch
    {
        "Forming" => "Forming（形成期）",
        "Learning" => "Learning（学習期）",
        "Adaptation" => "Adaptation（適応期）",
        "Stable" => "Stable（安定期）",
        "Emergent" => "Emergent（創発期）",
        "Silo" => "Silo（サイロ化）",
        "Chaos" => "Chaos（混乱）",
        "Collapse" => "Collapse（崩壊）",
        _ => phase ?? "-"
    };

    private static string FormatStatus(string? status) => status switch
    {
        "Created" => "Created（作成済み）",
        "Running" => "Running（実行中）",
        "StopRequested" => "StopRequested（停止要求）",
        "Stopped" => "Stopped（停止済み）",
        "Completed" => "Completed（完了）",
        _ => status ?? "-"
    };

    private static string GetComponentBadgeClass(int componentCount) => componentCount switch
    {
        >= 4 => "component-badge component-badge-danger",
        >= 2 => "component-badge component-badge-warning",
        _ => ""
    };

    private static string GetComponentBadgeText(int componentCount) => componentCount switch
    {
        >= 4 => "ネットワーク分断",
        >= 2 => "サイロ形成",
        _ => ""
    };

    private static string GetThresholdSweepRowClass(double componentCount) => componentCount switch
    {
        >= 4 => "threshold-sweep-critical",
        >= 2 => "threshold-sweep-warning",
        _ => ""
    };

    private static string FormatSigned(double value, string format = "0.00")
    {
        return value.ToString($"+{format};-{format};0.00");
    }
}

@if (Model.Experiment is null)
{
    <div class="alert alert-warning">Experiment が見つかりません。</div>
    return;
}

<div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
        <a asp-page="/Experiments/Index" class="text-decoration-none small">&larr; Experiments</a>
        <h1 class="h2 mt-2 mb-1">@Model.Experiment.Name</h1>
        <div class="text-muted">@Model.Experiment.Description</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-page="/Experiments/Run" asp-route-id="@Model.Experiment.Id">実験実行</a>
        @if (Model.Experiment.Status == EmergentEngineering.Models.ExperimentStatus.Running)
        {
            <form method="post" asp-page-handler="Stop" asp-route-id="@Model.Experiment.Id">
                <button type="submit" class="btn btn-outline-warning">実験停止</button>
            </form>
        }
        <a class="btn btn-outline-danger" asp-page="/Experiments/Delete" asp-route-id="@Model.Experiment.Id">削除</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ExperimentMessage))
{
    <div class="alert alert-info">@Model.ExperimentMessage</div>
}

<section class="summary-grid mb-4">
    <div>
        <h2 class="h6">Status</h2>
        <p>@FormatStatus(Model.Experiment.Status)</p>
    </div>
    <div>
        <h2 class="h6">Purpose</h2>
        <p>@Model.Experiment.Purpose</p>
    </div>
    <div>
        <h2 class="h6">Scenario</h2>
        <p>
            @if (Model.Experiment.ScenarioId.HasValue && Model.Experiment.Scenario is not null)
            {
                <a asp-page="/Scenarios/Details" asp-route-id="@Model.Experiment.ScenarioId">@Model.Experiment.Scenario.Name</a>
            }
            else
            {
                <span>-</span>
            }
        </p>
    </div>
    <div>
        <h2 class="h6">Boundary Conditions</h2>
        <p>@Model.Experiment.BoundaryConditions</p>
    </div>
    <div>
        <h2 class="h6">KPI</h2>
        <p>@Model.Experiment.KpiDefinition</p>
    </div>
    <div>
        <h2 class="h6">LLMプロバイダー</h2>
        <p>@Model.Experiment.LlmProvider</p>
    </div>
    <div>
        <h2 class="h6">LLMモデル</h2>
        <p>@Model.Experiment.LlmModel</p>
    </div>
    <div>
        <h2 class="h6">Agent Count</h2>
        <p>@Model.Experiment.AgentCount</p>
    </div>
    <div>
        <h2 class="h6">Total Steps</h2>
        <p>@Model.Experiment.TotalSteps</p>
    </div>
    <div>
        <h2 class="h6">Run Count</h2>
        <p>@Model.Experiment.RunCount</p>
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">境界条件パラメータ</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <tbody>
                <tr><th>情報共有</th><td>@Model.Experiment.InformationSharingLevel.ToString("0.0")</td></tr>
                <tr><th>協調性</th><td>@Model.Experiment.CooperationLevel.ToString("0.0")</td></tr>
                <tr><th>競争性</th><td>@Model.Experiment.CompetitionLevel.ToString("0.0")</td></tr>
                <tr><th>心理的安全性</th><td>@Model.Experiment.PsychologicalSafetyLevel.ToString("0.0")</td></tr>
                <tr><th>学習志向</th><td>@Model.Experiment.LearningOrientationLevel.ToString("0.0")</td></tr>
                <tr><th>顧客志向</th><td>@Model.Experiment.CustomerOrientationLevel.ToString("0.0")</td></tr>
                <tr><th>短期成果圧力</th><td>@Model.Experiment.ShortTermResultPressureLevel.ToString("0.0")</td></tr>
                <tr><th>実効信頼閾値</th><td>@Model.Experiment.EffectiveTrustThreshold.ToString("0.00")</td></tr>
                <tr><th>知識蓄積</th><td>@Model.Experiment.KnowledgeStock.ToString("0.00")</td></tr>
                <tr><th>知識多様性</th><td>@Model.Experiment.KnowledgeDiversity.ToString("0.00")</td></tr>
                <tr><th>外部刺激レベル</th><td>@Model.Experiment.ExternalShockLevel.ToString("0.00")</td></tr>
                <tr><th>異分野接触度</th><td>@Model.Experiment.CrossDomainExposure.ToString("0.00")</td></tr>
                <tr><th>再配線感度</th><td>@Model.Experiment.RewiringSensitivity.ToString("0.00")</td></tr>
                <tr><th>外部刺激を有効化</th><td>@(Model.Experiment.EnableExternalShock ? "Yes" : "No")</td></tr>
                <tr><th>外部刺激Step</th><td>@Model.Experiment.ShockStep</td></tr>
                <tr><th>外部刺激タイプ</th><td>@Model.Experiment.ShockType</td></tr>
                <tr><th>外部刺激説明</th><td>@(string.IsNullOrWhiteSpace(Model.Experiment.ShockDescription) ? "-" : Model.Experiment.ShockDescription)</td></tr>
                <tr><th>Challengeを有効化</th><td>@(Model.Experiment.EnableChallengeEvent ? "Yes" : "No")</td></tr>
                <tr><th>Challenge発生Step</th><td>@Model.Experiment.ChallengeStep</td></tr>
                <tr><th>Challengeタイプ</th><td>@Model.Experiment.ChallengeType</td></tr>
                <tr><th>Challengeレベル</th><td>@Model.Experiment.ChallengeLevel.ToString("0.00")</td></tr>
                <tr><th>Challenge説明</th><td>@(string.IsNullOrWhiteSpace(Model.Experiment.ChallengeDescription) ? "-" : Model.Experiment.ChallengeDescription)</td></tr>
                <tr><th>必要知識多様性</th><td>@Model.Experiment.RequiredKnowledgeDiversity.ToString("0.00")</td></tr>
                <tr><th>必要異分野接触度</th><td>@Model.Experiment.RequiredCrossDomainExposure.ToString("0.00")</td></tr>
                <tr><th>必要再配線スコア</th><td>@Model.Experiment.RequiredRewiringScore.ToString("0.00")</td></tr>
            </tbody>
        </table>
    </div>
</section>

<section class="log-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">Run Summary</h2>
            <p class="text-muted small mb-0">Average Trust: @Model.AverageTrustOverall.ToString("0.00") / Average Components: @Model.AverageComponentCountOverall.ToString("0.00")</p>
        </div>
    </div>
    @if (Model.Runs.Count == 0)
    {
        <p class="text-muted mb-0">まだ Run はありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Run</th>
                        <th>Simulation</th>
                        <th>LLM</th>
                        <th>Final Phase</th>
                        <th>Average Trust</th>
                        <th>Network Density</th>
                        <th>Effective Density</th>
                        <th>Strong Links</th>
                        <th>Components</th>
                        <th>Isolated</th>
                        <th>Hub</th>
                        <th>ShareInfo Rate</th>
                        <th>ProposeIdea Rate</th>
                        <th>Phase Stability</th>
                        <th>Steps</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var run in Model.Runs)
                {
                    <tr>
                        <td>@run.RunNo</td>
                        <td>@run.SimulationProject?.Name</td>
                        <td>@(run.SimulationProject is null ? "-" : $"{run.SimulationProject.LlmProvider} / {run.SimulationProject.LlmModel}")</td>
                        <td><span class="phase-pill">@FormatPhase(run.FinalPhase)</span></td>
                        <td>@run.AverageTrust.ToString("0.00")</td>
                        <td>@run.NetworkDensity.ToString("0.000")</td>
                        <td>@run.EffectiveNetworkDensity.ToString("0.000")</td>
                        <td>@run.StrongLinkCount</td>
                        <td>
                            @run.ComponentCount
                            @if (run.ComponentCount >= 2)
                            {
                                <span class="@GetComponentBadgeClass(run.ComponentCount)">@GetComponentBadgeText(run.ComponentCount)</span>
                            }
                        </td>
                        <td>@run.IsolatedAgentCount</td>
                        <td>@run.HubAgentName (@run.HubScore.ToString("0.00"))</td>
                        <td>@run.ShareInfoRate.ToString("0.000")</td>
                        <td>@run.ProposeIdeaRate.ToString("0.000")</td>
                        <td>@run.PhaseStability.ToString("0.000")</td>
                        <td>@run.CompletedSteps</td>
                        <td>@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Simulations/Details" asp-route-id="@run.SimulationProjectId">詳細</a>
                                <form method="post" asp-page-handler="DeleteRun" asp-route-id="@Model.Experiment.Id" asp-route-runId="@run.Id" onsubmit="return confirm('このRunと関連シミュレーションを削除します。よろしいですか。');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">このRunを削除</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">知識再配線サマリー</h2>
            <p class="text-muted small mb-0">知識蓄積、知識多様性、外部刺激、再配線スコアの観点から Run を比較します。</p>
        </div>
    </div>
    @if (Model.RunFingerprints.Count == 0)
    {
        <p class="text-muted mb-0">まだ知識再配線を集計できる Run はありません。</p>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">平均KnowledgeStock</div>
                    <div class="fs-5">@Model.AverageKnowledgeStockMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">平均KnowledgeDiversity</div>
                    <div class="fs-5">@Model.AverageKnowledgeDiversityMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">平均KnowledgeRewiringScore</div>
                    <div class="fs-5">@Model.AverageKnowledgeRewiringScoreMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">平均KnowledgeReconfigurationScore</div>
                    <div class="fs-5">@Model.AverageKnowledgeReconfigurationScoreMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">Challenge解決Run数 / Emergent到達Run数</div>
                    <div class="fs-5">@Model.ChallengeResolvedRunCount / @Model.EmergentReachedRunCount</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">平均ChallengeResolutionScore</div>
                    <div class="fs-5">@Model.AverageChallengeResolutionScoreMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">平均AdaptationDuration / Shock発生Run数</div>
                    <div class="fs-5">@Model.AverageAdaptationDurationMean.ToString("0.000") / @Model.ShockOccurredRunCount</div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Run</th>
                        <th>FinalPhase</th>
                        <th>AverageKnowledgeStock</th>
                        <th>AverageKnowledgeDiversity</th>
                        <th>AverageKnowledgeReconfigurationScore</th>
                        <th>MaxRewiringScore</th>
                        <th>ShockOccurred</th>
                        <th>Challenge</th>
                        <th>ChallengeResolvedStep</th>
                        <th>AdaptationDuration</th>
                        <th>FinalKnowledgeRewiringScore</th>
                        <th>KnowledgeDrivenType</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.RunFingerprints.OrderBy(fingerprint => fingerprint.RunNo ?? int.MaxValue).ThenBy(fingerprint => fingerprint.SimulationProjectId))
                {
                    <tr>
                        <td>@(item.RunNo?.ToString() ?? "-")</td>
                        <td><span class="phase-pill">@FormatPhase(item.FinalPhase)</span></td>
                        <td>@item.AverageKnowledgeStock.ToString("0.000")</td>
                        <td>@item.AverageKnowledgeDiversity.ToString("0.000")</td>
                        <td>@item.AverageKnowledgeReconfigurationScore.ToString("0.000")</td>
                        <td>@item.MaxKnowledgeRewiringScore.ToString("0.000")</td>
                        <td>@(item.ShockOccurred ? item.ShockType : "-")</td>
                        <td>@(item.ChallengeOccurred ? (item.ChallengeResolved ? "Resolved" : "Active") : "-")</td>
                        <td>@(item.ChallengeResolvedStep?.ToString() ?? "-")</td>
                        <td>@item.AdaptationDuration</td>
                        <td>@item.FinalKnowledgeRewiringScore.ToString("0.000")</td>
                        <td>@item.KnowledgeDrivenType</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="row g-4">
    <div class="col-lg-6">
        <section class="log-section h-100">
            <h2 class="h5 mb-3">Final Phase Distribution</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Phase</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.PhaseDistribution)
                    {
                        <tr>
                            <td>@FormatPhase(row.Phase)</td>
                            <td>@row.Count</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <div class="col-lg-6">
        <section class="log-section h-100">
            <h2 class="h5 mb-3">Phase Transitions</h2>
            @if (Model.PhaseTransitions.Count == 0)
            {
                <p class="text-muted mb-0">まだ phase transition データはありません。</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>From</th>
                                <th>To</th>
                                <th>Count</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var transition in Model.PhaseTransitions)
                        {
                            <tr>
                                <td>@FormatPhase(transition.FromPhase)</td>
                                <td>@FormatPhase(transition.ToPhase)</td>
                                <td>@transition.Count</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

<section class="log-section mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">相予兆スコア集計</h2>
            <p class="text-muted small mb-0">各Stepの相予兆スコアを複数Runで平均し、サイロ化・安定化・創発化の前兆を比較します。</p>
        </div>
    </div>
    @if (Model.PrecursorSummary.Count == 0)
    {
        <p class="text-muted mb-0">まだ前兆スコアを集計できるデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Step</th>
                        <th>Run数</th>
                        <th>Silo Risk</th>
                        <th>Stable Score</th>
                        <th>Emergent Score</th>
                        <th>主信号</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.PrecursorSummary)
                {
                    <tr>
                        <td>@point.StepNo</td>
                        <td>@point.RunCount</td>
                        <td>@point.AverageSiloRiskScore.ToString("0.000")</td>
                        <td>@point.AverageStableScore.ToString("0.000")</td>
                        <td>@point.AverageEmergentScore.ToString("0.000")</td>
                        <td>@point.MainSignal</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">創発指紋サマリー</h2>
            <p class="text-muted small mb-0">各Run全体を特徴量ベクトルとして要約し、創発の振る舞いを比較します。</p>
        </div>
    </div>
    @if (Model.RunFingerprints.Count == 0)
    {
        <p class="text-muted mb-0">まだ創発指紋を集計できるRunはありません。</p>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">平均信頼度 mean</div>
                    <div class="fs-5">@Model.FingerprintAverageTrustMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">実効密度 mean</div>
                    <div class="fs-5">@Model.FingerprintEffectiveDensityMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">相転移回数 mean</div>
                    <div class="fs-5">@Model.FingerprintPhaseTransitionCountMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">相安定度 mean</div>
                    <div class="fs-5">@Model.FingerprintPhaseStabilityMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">情報共有率 mean</div>
                    <div class="fs-5">@Model.FingerprintShareInfoRateMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">単独作業率 mean</div>
                    <div class="fs-5">@Model.FingerprintWorkAloneRateMean.ToString("0.000")</div>
                </div>
            </div>
            <div class="col-md-12 col-xl-4">
                <div class="border rounded p-3 h-100">
                    <div class="small text-muted">閾値脆弱性 mean</div>
                    <div class="fs-5">@Model.FingerprintThresholdFragilityScoreMean.ToString("0.000")</div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Run</th>
                        <th>Simulation</th>
                        <th>最終相</th>
                        <th>平均信頼度</th>
                        <th>実効密度</th>
                        <th>相転移回数</th>
                        <th>相安定度</th>
                        <th>情報共有率</th>
                        <th>単独作業率</th>
                        <th>主要TriggerAgent</th>
                        <th>閾値脆弱性</th>
                        <th>分類</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.RunFingerprints.OrderBy(fingerprint => fingerprint.RunNo ?? int.MaxValue).ThenBy(fingerprint => fingerprint.SimulationProjectId))
                {
                    <tr>
                        <td>@(item.RunNo?.ToString() ?? "-")</td>
                        <td><a asp-page="/Simulations/Details" asp-route-id="@item.SimulationProjectId">@item.SimulationName</a></td>
                        <td><span class="phase-pill">@FormatPhase(item.FinalPhase)</span></td>
                        <td>@item.AverageTrust.ToString("0.000")</td>
                        <td>@item.EffectiveDensity.ToString("0.000")</td>
                        <td>@item.PhaseTransitionCount</td>
                        <td>@item.PhaseStability.ToString("0.000")</td>
                        <td>@item.ShareInfoRate.ToString("0.000")</td>
                        <td>@item.WorkAloneRate.ToString("0.000")</td>
                        <td>@item.TopTriggerAgentName (@item.TopTriggerAgentCount)</td>
                        <td>@item.ThresholdFragilityScore.ToString("0.000")</td>
                        <td>@item.ClassificationLabel</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">Emergence Explainer 集計</h2>
