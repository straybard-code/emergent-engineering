@page
@model EmergentEngineering.Pages.Experiments.CreateModel
@{
    ViewData["Title"] = "新規 Experiment";
    ViewData["PresetFieldPrefix"] = "Input";
    ViewData["ExecutionScaleFieldPrefix"] = "Input";
}

<div class="page-heading">
    <h1 class="h2">新規 Experiment</h1>
    <p class="text-muted">Scenario から条件を読み込むか、手動で実験条件を入力します。</p>
</div>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Scenario 選択</h2>
    <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
        <div>
            <label class="form-label" for="scenarioId">読み込み元 Scenario</label>
            <select class="form-select" id="scenarioId" name="scenarioId">
                <option value="">手動入力</option>
                @foreach (var scenario in Model.Scenarios)
                {
                    <option value="@scenario.Id" selected="@(Model.ScenarioId == scenario.Id ? "selected" : null)">@scenario.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline-primary">読み込む</button>
    </form>
    @if (Model.ScenarioId.HasValue)
    {
        <p class="small text-muted mt-2 mb-0">選択した Scenario の値を初期値として読み込んでいます。</p>
    }
</section>

<form method="post" class="simulation-form">
    <input type="hidden" asp-for="ScenarioId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">名前</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <partial name="_ResearchPresetPanel" />

    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label">説明</label>
        <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Purpose" class="form-label">目的</label>
        <textarea asp-for="Input.Purpose" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.Purpose" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.BoundaryConditions" class="form-label">境界条件</label>
        <textarea asp-for="Input.BoundaryConditions" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Input.BoundaryConditions" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.KpiDefinition" class="form-label">KPI</label>
        <textarea asp-for="Input.KpiDefinition" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.KpiDefinition" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.LlmProvider" class="form-label">LLMプロバイダー</label>
            <select asp-for="Input.LlmProvider" class="form-select">
                <option value="Mock">Mock（高速・無料）</option>
                <option value="OpenAI">OpenAI（高精度・有料）</option>
            </select>
            <div class="form-text">大規模な条件比較や多数 Run は Mock、小規模検証は OpenAI を推奨します。</div>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Input.LlmModel" class="form-label">LLMモデル</label>
            <select asp-for="Input.LlmModel" class="form-select">
                <option value="mock-v1">mock-v1</option>
                <option value="gpt-4o-mini">gpt-4o-mini</option>
                <option value="gpt-4o">gpt-4o</option>
                <option value="gpt-5.5">gpt-5.5</option>
                <option value="gpt-5.6">gpt-5.6</option>
            </select>
            <div class="form-text">Mock では mock-v1、OpenAI では gpt-4o-mini を初期選択として想定しています。</div>
        </div>
    </div>

    <partial name="_ExecutionScalePresetPanel" />

    <div class="alert alert-info mt-3">
        <strong>保存モード：</strong> Experiment は <span class="fw-semibold">Summary 保存</span> で実行します。
        <div class="small mb-0">5 step ごとと最終 Step を中心に保存し、詳細分析に必要な量へ抑えます。</div>
    </div>

    <section class="log-section mb-4 optional-settings" data-optional-section="external-shock">
        <h2 class="h5 mb-3">境界条件パラメータ</h2>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Input.InformationSharingLevel" class="form-label">情報共有</label>
                <input asp-for="Input.InformationSharingLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.CooperationLevel" class="form-label">協調性</label>
                <input asp-for="Input.CooperationLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.CompetitionLevel" class="form-label">競争性</label>
                <input asp-for="Input.CompetitionLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.PsychologicalSafetyLevel" class="form-label">心理的安全性</label>
                <input asp-for="Input.PsychologicalSafetyLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.LearningOrientationLevel" class="form-label">学習志向</label>
                <input asp-for="Input.LearningOrientationLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.CustomerOrientationLevel" class="form-label">顧客志向</label>
                <input asp-for="Input.CustomerOrientationLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ShortTermResultPressureLevel" class="form-label">短期成果圧力</label>
                <input asp-for="Input.ShortTermResultPressureLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.EffectiveTrustThreshold" class="form-label">実効信頼閾値</label>
                <input asp-for="Input.EffectiveTrustThreshold" class="form-control" type="number" min="0" max="1" step="0.01" />
                <div class="form-text">この値以上の Trust のみネットワーク接続として扱います。</div>
            </div>
        </div>
    </section>

    <section class="log-section mb-4 optional-settings" data-optional-section="challenge">
        <h2 class="h5 mb-3">知識・再配線パラメータ</h2>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Input.KnowledgeStock" class="form-label">知識蓄積</label>
                <input asp-for="Input.KnowledgeStock" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.KnowledgeDiversity" class="form-label">知識多様性</label>
                <input asp-for="Input.KnowledgeDiversity" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ExternalShockLevel" class="form-label">外部刺激レベル</label>
                <input asp-for="Input.ExternalShockLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.CrossDomainExposure" class="form-label">異分野接触度</label>
                <input asp-for="Input.CrossDomainExposure" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.RewiringSensitivity" class="form-label">再配線感度</label>
                <input asp-for="Input.RewiringSensitivity" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
        </div>
    </section>

    <section class="log-section mb-4">
        <h2 class="h5 mb-3">外部刺激設定</h2>
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-check mt-4">
                    <input asp-for="Input.EnableExternalShock" class="form-check-input" type="checkbox" />
                    <label asp-for="Input.EnableExternalShock" class="form-check-label">外部刺激を有効化</label>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ShockStep" class="form-label">外部刺激 Step</label>
                <input asp-for="Input.ShockStep" class="form-control" type="number" min="0" max="100" step="1" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ShockType" class="form-label">外部刺激タイプ</label>
                <select asp-for="Input.ShockType" class="form-select">
                    @foreach (var shockType in EmergentEngineering.Models.ShockTypes.All)
                    {
                        <option value="@shockType">@shockType</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ShockDescription" class="form-label">外部刺激説明</label>
                <input asp-for="Input.ShockDescription" class="form-control" />
            </div>
        </div>
    </section>

    <section class="log-section mb-4">
        <h2 class="h5 mb-3">Challenge 設定</h2>
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-check mt-4">
                    <input asp-for="Input.EnableChallengeEvent" class="form-check-input" type="checkbox" />
                    <label asp-for="Input.EnableChallengeEvent" class="form-check-label">Challenge を有効化</label>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ChallengeStep" class="form-label">Challenge 発生 Step</label>
                <input asp-for="Input.ChallengeStep" class="form-control" type="number" min="0" max="100" step="1" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ChallengeType" class="form-label">Challenge タイプ</label>
                <select asp-for="Input.ChallengeType" class="form-select">
                    @foreach (var challengeType in EmergentEngineering.Models.ChallengeTypes.All)
                    {
                        <option value="@challengeType">@challengeType</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ChallengeLevel" class="form-label">Challenge レベル</label>
                <input asp-for="Input.ChallengeLevel" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-12 mb-3">
                <label asp-for="Input.ChallengeDescription" class="form-label">Challenge 説明</label>
                <input asp-for="Input.ChallengeDescription" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.RequiredKnowledgeDiversity" class="form-label">必要知識多様性</label>
                <input asp-for="Input.RequiredKnowledgeDiversity" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.RequiredCrossDomainExposure" class="form-label">必要異分野接触度</label>
                <input asp-for="Input.RequiredCrossDomainExposure" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.RequiredRewiringScore" class="form-label">必要再配線スコア</label>
                <input asp-for="Input.RequiredRewiringScore" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
        </div>
    </section>

    <section class="log-section mb-4">
        <h2 class="h5 mb-3">セレンディピティ設定</h2>
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-check mt-4">
                    <input asp-for="Input.EnableSerendipity" class="form-check-input" type="checkbox" />
                    <label asp-for="Input.EnableSerendipity" class="form-check-label">セレンディピティを有効化</label>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.SerendipityThreshold" class="form-label">セレンディピティ閾値</label>
                <input asp-for="Input.SerendipityThreshold" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.ExplorationTendency" class="form-label">探索傾向</label>
                <input asp-for="Input.ExplorationTendency" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.SerendipitySensitivity" class="form-label">セレンディピティ感受性</label>
                <input asp-for="Input.SerendipitySensitivity" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.KnowledgeRecombinationRate" class="form-label">知識再結合率</label>
                <input asp-for="Input.KnowledgeRecombinationRate" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
        </div>
    </section>

    <section class="log-section mb-4">
        <h2 class="h5 mb-3">信頼ダイナミクス</h2>
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-check mt-4">
                    <input asp-for="Input.EnableTrustDynamics" class="form-check-input" type="checkbox" />
                    <label asp-for="Input.EnableTrustDynamics" class="form-check-label">Trust Dynamics を有効化</label>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.TrustGrowthRate" class="form-label">信頼成長率</label>
                <input asp-for="Input.TrustGrowthRate" class="form-control" type="number" min="0" max="2" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.TrustDecayRate" class="form-label">信頼自然減衰率</label>
                <input asp-for="Input.TrustDecayRate" class="form-control" type="number" min="0" max="1" step="0.001" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.TrustSaturationStrength" class="form-label">信頼飽和強度</label>
                <input asp-for="Input.TrustSaturationStrength" class="form-control" type="number" min="0" max="1" step="0.01" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.TrustCapacity" class="form-label">信頼容量</label>
                <input asp-for="Input.TrustCapacity" class="form-control" type="number" min="1" max="20" step="1" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.TrustCapacityPenalty" class="form-label">信頼容量ペナルティ</label>
                <input asp-for="Input.TrustCapacityPenalty" class="form-control" type="number" min="0" max="1" step="0.001" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.DistrustPenalty" class="form-label">不信ペナルティ</label>
                <input asp-for="Input.DistrustPenalty" class="form-control" type="number" min="0" max="1" step="0.001" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ConstructiveCriticismBonus" class="form-label">建設的批判ボーナス</label>
                <input asp-for="Input.ConstructiveCriticismBonus" class="form-control" type="number" min="0" max="1" step="0.001" />
            </div>
        </div>
    </section>
    <partial name="_ThanksCoinFields" model="Model.Input" />

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Input.AgentCount" class="form-label">Agent数</label>
            <input asp-for="Input.AgentCount" class="form-control" type="number" min="1" max="100" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.TotalSteps" class="form-label">Step数</label>
            <input asp-for="Input.TotalSteps" class="form-control" type="number" min="1" max="5000" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.RunCount" class="form-label">Run数</label>
            <input asp-for="Input.RunCount" class="form-control" type="number" min="1" max="100" />
            <div class="form-text">最初は 3〜5 Run を推奨します。</div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">作成</button>
        <a asp-page="/Experiments/Index" class="btn btn-outline-secondary">キャンセル</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_OptionalEventSectionScripts" />
}
