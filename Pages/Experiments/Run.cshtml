@page "{id:int}"
@model EmergentEngineering.Pages.Experiments.RunModel
@{
    ViewData["Title"] = Model.Experiment?.Name ?? "実験実行";
}

@if (Model.Experiment is null)
{
    <div class="alert alert-warning">Experiment が見つかりません。</div>
    return;
}

<div class="page-heading">
    <a asp-page="/Experiments/Details" asp-route-id="@Model.Experiment.Id" class="text-decoration-none small">&larr; 実験詳細</a>
    <h1 class="h2 mt-2">@Model.Experiment.Name</h1>
    <p class="text-muted">この Experiment 条件から独立した SimulationProject を @Model.Experiment.RunCount 回生成し、順番に実行します。</p>
    <p class="text-muted mb-0">最初は 3〜5 回程度を推奨します。件数が増えるほど処理時間は長くなります。</p>
</div>

<section class="summary-grid mb-4">
    <div>
        <h2 class="h6">Purpose</h2>
        <p>@Model.Experiment.Purpose</p>
    </div>
    <div>
        <h2 class="h6">Boundary Conditions</h2>
        <p>@Model.Experiment.BoundaryConditions</p>
    </div>
    <div>
        <h2 class="h6">KPI</h2>
        <p>@Model.Experiment.KpiDefinition</p>
    </div>
</section>

<form method="post">
    <button type="submit" class="btn btn-primary">@Model.Experiment.RunCount 回実行</button>
</form>
