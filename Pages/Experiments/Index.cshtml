@page
@model EmergentEngineering.Pages.Experiments.IndexModel
@{
    ViewData["Title"] = "Experiments";
}

@functions {
    private static string FormatStatus(string? status) => IndexModel.GetStatusCategory(status) switch
    {
        ExperimentStatusCategory.Pending => "未実行",
        ExperimentStatusCategory.Running => "実行中",
        ExperimentStatusCategory.Completed => "完了",
        ExperimentStatusCategory.Failed => "失敗",
        ExperimentStatusCategory.Cancelled => "停止",
        _ => "-"
    };

    private static string GetStatusBadgeClass(string? status) => IndexModel.GetStatusCategory(status) switch
    {
        ExperimentStatusCategory.Pending => "status-badge status-pending",
        ExperimentStatusCategory.Running => "status-badge status-running",
        ExperimentStatusCategory.Completed => "status-badge status-completed",
        ExperimentStatusCategory.Failed => "status-badge status-failed",
        ExperimentStatusCategory.Cancelled => "status-badge status-cancelled",
        _ => "status-badge status-pending"
    };

    private static string GetRowClass(string? status) => IndexModel.GetStatusCategory(status) switch
    {
        ExperimentStatusCategory.Running => "experiment-running",
        _ => ""
    };

    private static bool IsDeleteBlocked(string? status) => IndexModel.IsDeletionBlocked(status);
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h2 mb-1">Experiments</h1>
        <p class="text-muted mb-0">同じ条件で複数回の実行結果を比較し、Phase 遷移と Trust 状態を確認します。</p>
    </div>
    <a class="btn btn-primary" asp-page="/Experiments/Create">新規 Experiment</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.CleanupMessage))
{
    <div class="alert alert-info">@Model.CleanupMessage</div>
}

<div class="text-muted small mb-3">実行中のまま停止している場合のみ使用してください。</div>

<section class="experiment-status-summary mb-4">
    <span class="status-badge status-running">実行中: @Model.RunningCount</span>
    <span class="status-badge status-completed">完了: @Model.CompletedCount</span>
    <span class="status-badge status-pending">未実行: @Model.PendingCount</span>
    <span class="status-badge status-failed">失敗: @Model.FailedCount</span>
    <span class="status-badge status-cancelled">停止: @Model.CancelledCount</span>
</section>

@if (Model.Experiments.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">Experiment はまだありません</h2>
        <p>比較したい条件セットを作成してから複数 Run を実行します。</p>
    </div>
}
else
{
    <form method="post" asp-page-handler="DeleteSelected" onsubmit="return confirm('選択したExperimentと関連するRun、Simulation、Step、Action、TrustSnapshotを削除します。よろしいですか？');">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
            <div class="text-muted small">実行中のExperimentは削除できません。</div>
            <button type="submit" class="btn btn-danger">選択したExperimentを削除</button>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 2.5rem;">
                            <input type="checkbox" id="selectAllExperiments" class="form-check-input" aria-label="全選択" />
                        </th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Run Count</th>
                        <th>Agents</th>
                        <th>Steps</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var experiment in Model.Experiments)
                {
                    <tr class="@GetRowClass(experiment.Status)">
                        <td>
                            @if (IsDeleteBlocked(experiment.Status))
                            {
                                <input type="checkbox" class="form-check-input experiment-delete-checkbox" disabled aria-label="削除不可" />
                            }
                            else
                            {
                                <input type="checkbox" class="form-check-input experiment-delete-checkbox" name="SelectedExperimentIds" value="@experiment.Id" aria-label="@experiment.Name を選択" />
                            }
                        </td>
                        <td>
                            <strong>@experiment.Name</strong>
                            <div class="text-muted small">@experiment.Description</div>
                        </td>
                        <td><span class="@GetStatusBadgeClass(experiment.Status)">@FormatStatus(experiment.Status)</span></td>
                        <td>@experiment.RunCount</td>
                        <td>@experiment.AgentCount</td>
                        <td>@experiment.TotalSteps</td>
                        <td>@experiment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Experiments/Details" asp-route-id="@experiment.Id">詳細</a>
                                @if (string.Equals(experiment.Status, EmergentEngineering.Models.ExperimentStatus.Running, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-warning" form="mark-failed-experiment-@experiment.Id">失敗扱いにする</button>
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            form="force-delete-experiment-@experiment.Id">
                                        強制削除
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled>削除不可</button>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-danger" asp-page="/Experiments/Delete" asp-route-id="@experiment.Id">削除</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </form>

    @foreach (var experiment in Model.Experiments.Where(item => string.Equals(item.Status, EmergentEngineering.Models.ExperimentStatus.Running, StringComparison.OrdinalIgnoreCase)))
    {
        <form id="mark-failed-experiment-@experiment.Id" method="post" asp-page-handler="MarkFailed">
            <input type="hidden" name="id" value="@experiment.Id" />
        </form>
        <form id="force-delete-experiment-@experiment.Id"
              method="post"
              asp-page-handler="ForceDelete"
              onsubmit="return confirm('実行中のデータを強制削除します。関連するStep、Action、TrustSnapshotも削除されます。よろしいですか？');">
            <input type="hidden" name="id" value="@experiment.Id" />
        </form>
    }
}

@section Scripts {
    <script>
        (() => {
            const selectAll = document.getElementById('selectAllExperiments');
            if (!selectAll) {
                return;
            }

            selectAll.addEventListener('change', () => {
                document.querySelectorAll('.experiment-delete-checkbox:not(:disabled)').forEach(checkbox => {
                    checkbox.checked = selectAll.checked;
                });
            });
        })();
    </script>
}
