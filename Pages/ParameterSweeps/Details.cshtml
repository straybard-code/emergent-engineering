@page "{id:int}"
@model EmergentEngineering.Pages.ParameterSweeps.DetailsModel
@{
    ViewData["Title"] = Model.Sweep?.Name ?? "パラメータスイープ詳細";
    var phases = new[]
    {
        EmergentEngineering.Models.SimulationPhase.Forming,
        EmergentEngineering.Models.SimulationPhase.Learning,
        EmergentEngineering.Models.SimulationPhase.Stable,
        EmergentEngineering.Models.SimulationPhase.Emergent,
        EmergentEngineering.Models.SimulationPhase.Silo,
        EmergentEngineering.Models.SimulationPhase.Chaos,
        EmergentEngineering.Models.SimulationPhase.Collapse
    };
}

@if (Model.Sweep is null)
{
    <div class="alert alert-warning">パラメータスイープが見つかりません。</div>
    return;
}

<div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
        <a asp-page="/ParameterSweeps/Index" class="text-decoration-none small">&larr; パラメータスイープ一覧</a>
        <h1 class="h2 mt-2 mb-1">@Model.Sweep.Name</h1>
        <div class="text-muted">@Model.Sweep.Description</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Sweep.Status == EmergentEngineering.Models.ParameterSweepStatus.Running)
        {
            <span class="status-badge status-running align-self-center">実行中</span>
        }
        else
        {
            <a class="btn btn-primary" asp-page="/ParameterSweeps/Run" asp-route-id="@Model.Sweep.Id">スイープ実行</a>
        }
        <a class="btn btn-outline-secondary" asp-page-handler="DownloadCsv" asp-route-id="@Model.Sweep.Id">CSV出力</a>
        <a class="btn btn-outline-secondary" asp-page="/Experiments/Index">関連Experimentを確認</a>
        @if (Model.Sweep.Status == EmergentEngineering.Models.ParameterSweepStatus.Running)
        {
            <form method="post" asp-page-handler="Stop" asp-route-id="@Model.Sweep.Id">
                <button type="submit" class="btn btn-outline-warning">スイープ停止</button>
            </form>
            <form method="post" asp-page-handler="MarkFailed" asp-route-id="@Model.Sweep.Id">
                <button type="submit" class="btn btn-outline-secondary">失敗扱いにする</button>
            </form>
            <form method="post"
                  asp-page-handler="ForceDelete"
                  asp-route-id="@Model.Sweep.Id"
                  onsubmit="return confirm('実行中のデータを強制削除します。関連するStep、Action、TrustSnapshotも削除されます。よろしいですか？');">
                <button type="submit" class="btn btn-outline-danger">強制削除</button>
            </form>
        }
        @if (Model.Sweep.Status == EmergentEngineering.Models.ParameterSweepStatus.Running)
        {
            <button type="button" class="btn btn-outline-danger" disabled>削除不可</button>
        }
        else
        {
            <a class="btn btn-outline-danger" asp-page="/ParameterSweeps/Delete" asp-route-id="@Model.Sweep.Id">削除</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SweepMessage))
{
    <div class="alert alert-info">@Model.SweepMessage</div>
}

@if (Model.Sweep.Status == EmergentEngineering.Models.ParameterSweepStatus.Running)
{
    <div class="alert alert-primary">
        <strong>スイープを実行中です。完了までしばらくお待ちください。</strong><br />
        <span class="small text-muted">画面を再読み込みすると進捗が更新されます。</span>
        <div class="small text-muted mt-1">実行中のまま停止している場合のみ使用してください。</div>
    </div>
}

<div class="alert alert-info mb-4">
    相図・スイープは大量Runを生成するため、通常は Summary / Minimal 保存を推奨します。Full保存は代表Runや検証Runのみ使用してください。
</div>

<section class="summary-grid mb-4">
    <div><h2 class="h6">名前</h2><p>@Model.Sweep.Name</p></div>
    <div><h2 class="h6">基準シナリオ</h2><p>@Model.ScenarioName</p></div>
    <div><h2 class="h6">対象パラメータ</h2><p>@EmergentEngineering.Models.BoundaryParameterNames.GetLabel(Model.Sweep.TargetParameter)</p></div>
    <div><h2 class="h6">開始値</h2><p>@Model.Sweep.StartValue.ToString("0.000")</p></div>
    <div><h2 class="h6">終了値</h2><p>@Model.Sweep.EndValue.ToString("0.000")</p></div>
    <div><h2 class="h6">刻み幅</h2><p>@Model.Sweep.StepValue.ToString("0.000")</p></div>
    <div><h2 class="h6">各値の実行回数</h2><p>@Model.Sweep.RunCountPerValue</p></div>
    <div><h2 class="h6">エージェント数</h2><p>@Model.Sweep.AgentCount</p></div>
    <div><h2 class="h6">総ステップ数</h2><p>@Model.Sweep.TotalSteps</p></div>
    <div><h2 class="h6">LLMプロバイダー</h2><p>@Model.Sweep.LlmProvider</p></div>
    <div><h2 class="h6">LLMモデル</h2><p>@Model.Sweep.LlmModel</p></div>
    <div><h2 class="h6">状態</h2><p>@Model.FormatStatus(Model.Sweep.Status)</p></div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-2">解析サマリー</h2>
    <p class="text-muted mb-3">このスイープ実験の主要な結果と、創発に至らなかった主な要因を要約します。</p>
    <div class="alert alert-primary mb-3">
        <strong>主要結論：</strong> @Model.PrimaryConclusionMessage
    </div>
    <div class="analysis-summary-grid mb-3">
        @foreach (var card in Model.SummaryCards)
        {
            <article class="summary-card">
                <div class="summary-card-label">@card.Label</div>
                <div class="summary-card-value">@card.Value</div>
            </article>
        }
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-2">自動解釈コメント</h2>
    <p class="text-muted mb-3">スイープ結果の読み取りを補助する短いコメントです。</p>
    <div class="summary-card summary-card-wide">
        <div class="summary-card-value summary-card-text">@Model.AnalysisComment</div>
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">相転移候補</h2>
    <p class="text-muted">隣接する ParameterValue 間の差分から、相転移候補を自動検出します。</p>
    @if (Model.TransitionCandidateRows.Count == 0)
    {
        <p class="text-muted mb-0">まだ相転移候補を表示できるデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>区間</th>
                        <th>種類</th>
                        <th>変化量</th>
                        <th>解釈</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.TransitionCandidateRows)
                {
                    <tr>
                        <td>@row.Interval</td>
                        <td><span class="status-badge status-running">@row.Type</span></td>
                        <td>@row.DeltaText <span class="text-muted">(@row.ImpactLabel)</span></td>
                        <td>@row.Interpretation</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">ボトルネック分析</h2>
    <p class="text-muted">Final Phase が Emergent ではない Run について、どの条件が不足していたかを集計します。</p>
    @if (Model.BottleneckAnalysisRows.Count == 0)
    {
        <p class="text-muted mb-0">まだボトルネック分析を表示できるデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>理由</th>
                        <th>件数</th>
                        <th>比率</th>
                        <th>解釈</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.BottleneckAnalysisRows)
                {
                    <tr>
                        <td>@row.Reason</td>
                        <td>@row.Count</td>
                        <td>@row.Rate.ToString("0.000")</td>
                        <td>@row.Interpretation</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-2">創発パイプライン概要</h2>
    <p class="text-muted mb-3">SerendipityからEmergenceまでの各段階がどの程度進んでいるかを平均値で表示します。</p>
    @if (Model.PipelineStageSummaries.Count == 0)
    {
        <p class="text-muted mb-0">このデータには創発パイプライン情報が含まれていません。新しくスイープを実行すると表示されます。</p>
    }
    else
    {
        <div class="pipeline-summary">
            @foreach (var row in Model.PipelineStageSummaries)
            {
                <div class="pipeline-row @(row.IsBottleneck ? "pipeline-bottleneck" : string.Empty)">
                    <div class="pipeline-label">@row.Label</div>
                    <div class="pipeline-bar">
                        <div class="pipeline-bar-fill" style="width:@($"{Math.Clamp(row.Value, 0, 1) * 100:0.#}%")"></div>
                    </div>
                    <div class="pipeline-value">@row.Value.ToString("0.00")</div>
                </div>
            }
        </div>
    }
</section>

<section class="chart-panel mb-4">
    <h2 class="h5 mb-2">創発パイプライン比較</h2>
    <p class="text-muted mb-4">対象パラメータごとに、創発パイプラインのどの段階が強くなり、どこがボトルネックになっているかを比較します。</p>
    @if (Model.AnalysisPoints.Count == 0)
    {
        <p class="text-muted mb-0">まだ創発パイプライン比較を表示できるデータはありません。</p>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-12">
                <h3 class="h6 mb-2">創発パイプライン比較</h3>
                <canvas id="sweepPipelineChart" height="180"></canvas>
            </div>
        </div>
        <div class="row g-4 mb-4">
            <div class="col-12">
                <h3 class="h6 mb-2">創発パイプライン完了度</h3>
                <canvas id="sweepPipelineCompletionChart" height="180"></canvas>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>Serendipity</th>
                        <th>KnowledgeRecombination</th>
                        <th>KnowledgeReconfiguration</th>
                        <th>Learning</th>
                        <th>Adaptation</th>
                        <th>Emergence</th>
                        <th>CompletionScore</th>
                        <th>MostCommonBottleneck</th>
                        <th>解釈</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.AnalysisPoints)
                {
                    <tr>
                        <td>@point.ParameterValue.ToString("0.000")</td>
                        <td>@point.AverageSerendipityScore.ToString("0.000")</td>
                        <td>@point.AverageKnowledgeRecombinationScore.ToString("0.000")</td>
                        <td>@point.AverageKnowledgeReconfigurationScore.ToString("0.000")</td>
                        <td>@point.AverageLearningScore.ToString("0.000")</td>
                        <td>@point.AverageAdaptationScore.ToString("0.000")</td>
                        <td>@point.AverageEmergentScore.ToString("0.000")</td>
                        <td>@point.AveragePipelineCompletionScore.ToString("0.000")</td>
                        <td>@point.MostCommonPipelineBottleneck</td>
                        <td>@point.PipelineBottleneckInterpretation</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Impact Path（影響経路）</h2>
    <p class="text-muted">対象パラメータの変化が、信頼・ネットワーク・知識・セレンディピティ・創発へどのように伝わったかを差分で表示します。</p>
    @if (Model.ImpactPathNodes.Count == 0)
    {
        <p class="text-muted mb-0">まだ影響経路を表示できるデータはありません。</p>
    }
    else
    {
        <div class="impact-path">
            @for (var index = 0; index < Model.ImpactPathNodes.Count; index++)
            {
                var node = Model.ImpactPathNodes[index];
                <div class="impact-node @node.CssClass">
                    <div class="impact-node-title">@node.Title</div>
                    <div class="impact-node-value">@node.ValueLine</div>
                    <div class="impact-node-note">@node.NoteLine</div>
                </div>
                @if (index < Model.ImpactPathNodes.Count - 1)
                {
                    <div class="impact-arrow">↓</div>
                }
            }
        </div>
        <div class="impact-path-meta mt-3">
            <div class="impact-path-meta-item">
                <span class="text-muted">対象パラメータ</span>
                <strong>@Model.TargetParameterLabel</strong>
            </div>
            <div class="impact-path-meta-item">
                <span class="text-muted">影響停止点</span>
                <strong>@Model.ImpactPathBottleneck</strong>
            </div>
        </div>
        <div class="alert alert-info mt-3 mb-0">@Model.ImpactPathInterpretation</div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">感度ランキング</h2>
    <p class="text-muted">対象パラメータの変化に対して、どの指標が大きく変化したかをランキング表示します。</p>
    @if (Model.SensitivityRanking.Count == 0)
    {
        <p class="text-muted mb-0">まだ感度ランキングを表示できるデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>指標</th>
                        <th>最小値</th>
                        <th>最大値</th>
                        <th>差分</th>
                        <th>影響度</th>
                        <th>解釈</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.SensitivityRanking)
                {
                    <tr class="@row.CssClass">
                        <td>@row.Rank</td>
                        <td>@row.Metric</td>
                        <td>@row.MinValue.ToString("0.000")</td>
                        <td>@row.MaxValue.ToString("0.000")</td>
                        <td>@Model.FormatImpactDelta(row.Delta, row.Metric == "Strong Links")</td>
                        <td>@row.ImpactLabel</td>
                        <td>@row.Interpretation</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="alert alert-secondary mb-0">@Model.SensitivityConclusion</div>
    }
</section>

<section class="chart-panel mb-4">
    <h2 class="h5 mb-2">相転移分析グラフ</h2>
    <p class="text-muted mb-4">対象パラメータの変化に対して、信頼ネットワーク・セレンディピティ・創発相がどのように変化するかを比較します。</p>
    @if (Model.AnalysisPoints.Count == 0)
    {
        <p class="text-muted mb-0">まだ相転移分析用のデータはありません。</p>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-6">
                <h3 class="h6 mb-2">信頼と実効密度</h3>
                <canvas id="sweepTrustDensityChart" height="180"></canvas>
            </div>
            <div class="col-lg-6">
                <h3 class="h6 mb-2">Strong / Weak Links</h3>
                <canvas id="sweepLinkChart" height="180"></canvas>
            </div>
            <div class="col-lg-6">
                <h3 class="h6 mb-2">相到達率</h3>
                <canvas id="sweepPhaseRateChart" height="180"></canvas>
            </div>
            <div class="col-lg-6">
                <h3 class="h6 mb-2">セレンディピティと創発リンク</h3>
                <canvas id="sweepSerendipityChart" height="180"></canvas>
            </div>
        </div>
        <div class="row g-4 mt-4">
            <div class="col-12">
                <h3 class="h6 mb-2">知識多様性と再結合</h3>
                <canvas id="sweepKnowledgeChart" height="180"></canvas>
            </div>
        </div>
        <div class="row g-4 mt-4">
            <div class="col-12">
                <h3 class="h6 mb-2">Phase Score 比較</h3>
                <canvas id="sweepPhaseScoreChart" height="180"></canvas>
            </div>
        </div>
    }
</section>

<section class="chart-panel mb-4">
    <div class="row g-4">
        <div class="col-lg-6">
            <h2 class="h5 mb-3">パラメータ値ごとの平均絶対信頼度</h2>
            @if (Model.Runs.Count == 0)
            {
                <p class="text-muted mb-0">まだスイープ結果はありません。</p>
            }
            else
            {
                <canvas id="averageAbsTrustChart" height="180"></canvas>
            }
        </div>
        <div class="col-lg-6">
            <h2 class="h5 mb-3">パラメータ値ごとの創発相到達数</h2>
            @if (Model.Runs.Count == 0)
            {
                <p class="text-muted mb-0">まだスイープ結果はありません。</p>
            }
            else
            {
                <canvas id="emergentCountChart" height="180"></canvas>
            }
        </div>
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Sweep結果一覧</h2>
    @if (Model.Runs.Count == 0)
    {
        <p class="text-muted mb-0">まだスイープ結果はありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>Experiment</th>
                        <th>FinalPhaseSummary</th>
                        <th>AverageTrust</th>
                        <th>AverageAbsTrust</th>
                        <th>CreatedAt</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var run in Model.Runs)
                {
                    <tr>
                        <td>@run.ParameterValue.ToString("0.000")</td>
                        <td><a asp-page="/Experiments/Details" asp-route-id="@run.ExperimentId">@Model.GetExperimentName(run.ExperimentId)</a></td>
                        <td>@Model.FormatPhaseSummary(run.FinalPhaseSummaryJson)</td>
                        <td>@run.AverageTrust.ToString("0.00")</td>
                        <td>@run.AverageAbsTrust.ToString("0.00")</td>
                        <td>@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">パラメータ差分分析</h2>
    <p class="text-muted">1つ前のパラメータ値と比較して、信頼・実効密度・創発率がどれだけ変化したかを確認します。</p>
    @if (Model.AnalysisPoints.Count == 0)
    {
        <p class="text-muted mb-0">まだ差分分析用のデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>AverageTrust</th>
                        <th>ΔTrust</th>
                        <th>EffectiveDensity</th>
                        <th>ΔEffectiveDensity</th>
                        <th>AverageKnowledgeDiversity</th>
                        <th>ΔKnowledgeDiversity</th>
                        <th>AverageKnowledgeRecombinationScore</th>
                        <th>ΔKnowledgeRecombination</th>
                        <th>AverageKnowledgeReconfigurationScore</th>
                        <th>ΔKnowledgeReconfiguration</th>
                        <th>AverageEmergentScore</th>
                        <th>ΔEmergentScore</th>
                        <th>AverageStableScore</th>
                        <th>ΔStableScore</th>
                        <th>AverageLearningScore</th>
                        <th>ΔLearningScore</th>
                        <th>AveragePipelineCompletionScore</th>
                        <th>ΔPipelineCompletionScore</th>
                        <th>EmergentRate</th>
                        <th>ΔEmergentRate</th>
                        <th>SerendipityRate</th>
                        <th>ΔSerendipityRate</th>
                        <th>StrongLinks</th>
                        <th>WeakLinks</th>
                        <th>ComponentCount</th>
                        <th>IsolatedAgents</th>
                        <th>相転移候補</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.AnalysisPoints)
                {
                    <tr class="@Model.GetTransitionRowClass(point)">
                        <td>@point.ParameterValue.ToString("0.000")</td>
                        <td>@point.AverageTrust.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaAverageTrust)</td>
                        <td>@point.EffectiveDensity.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaEffectiveDensity)</td>
                        <td>@point.AverageKnowledgeDiversity.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaKnowledgeDiversity)</td>
                        <td>@point.AverageKnowledgeRecombinationScore.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaKnowledgeRecombinationScore)</td>
                        <td>@point.AverageKnowledgeReconfigurationScore.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaKnowledgeReconfigurationScore)</td>
                        <td>@point.AverageEmergentScore.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaEmergentScore)</td>
                        <td>@point.AverageStableScore.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaStableScore)</td>
                        <td>@point.AverageLearningScore.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaLearningScore)</td>
                        <td>@point.AveragePipelineCompletionScore.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaPipelineCompletionScore)</td>
                        <td>@point.EmergentRate.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaEmergentRate)</td>
                        <td>@point.SerendipityRate.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaSerendipityRate)</td>
                        <td>@point.StrongLinks.ToString("0.00")</td>
                        <td>@point.WeakLinks.ToString("0.00")</td>
                        <td>@point.ComponentCount.ToString("0.00")</td>
                        <td>@point.IsolatedAgents.ToString("0.00")</td>
                        <td>@(string.IsNullOrWhiteSpace(point.TransitionCandidates) ? "-" : point.TransitionCandidates)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Emergent未達理由ランキング</h2>
    <p class="text-muted">Final Phase が Emergent ではない Run について、どの条件が不足していたかを集計します。</p>
    @if (Model.AnalysisPoints.Count == 0)
    {
        <p class="text-muted mb-0">まだ未達理由の分析データはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>主な未達理由</th>
                        <th>信頼不足Run数</th>
                        <th>実効密度不足Run数</th>
                        <th>StrongLink不足Run数</th>
                        <th>知識多様性不足Run数</th>
                        <th>知識再結合不足Run数</th>
                        <th>知識再構成不足Run数</th>
                        <th>セレンディピティ不足Run数</th>
                        <th>アイデア提案不足Run数</th>
                        <th>情報共有不足Run数</th>
                        <th>心理的安全性不足Run数</th>
                        <th>建設的批判不足Run数</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.AnalysisPoints)
                {
                    <tr>
                        <td>@point.ParameterValue.ToString("0.000")</td>
                        <td>@(string.IsNullOrWhiteSpace(point.MainEmergentFailureReason) ? "-" : point.MainEmergentFailureReason)</td>
                        <td>@point.TrustInsufficientRunCount</td>
                        <td>@point.EffectiveDensityInsufficientRunCount</td>
                        <td>@point.StrongLinkInsufficientRunCount</td>
                        <td>@point.KnowledgeDiversityInsufficientRunCount</td>
                        <td>@point.KnowledgeRecombinationInsufficientRunCount</td>
                        <td>@point.KnowledgeReconfigurationInsufficientRunCount</td>
                        <td>@point.SerendipityInsufficientRunCount</td>
                        <td>@point.IdeaProposalInsufficientRunCount</td>
                        <td>@point.ShareInfoInsufficientRunCount</td>
                        <td>@point.PsychologicalSafetyInsufficientRunCount</td>
                        <td>@point.ConstructiveCriticismInsufficientRunCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Phase分布比較</h2>
    @if (Model.PhaseComparison.Count == 0)
    {
        <p class="text-muted mb-0">まだ Phase 分布比較データはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        @foreach (var phase in phases)
                        {
                            <th>@phase</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.PhaseComparison)
                {
                    <tr>
                        <td>@row.ParameterValue.ToString("0.000")</td>
                        @foreach (var phase in phases)
                        {
                            <td>@row.GetCount(phase)</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section">
    <h2 class="h5 mb-3">信頼度比較</h2>
    @if (Model.Runs.Count == 0)
    {
        <p class="text-muted mb-0">まだ信頼度比較データはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>AverageTrust</th>
                        <th>AverageAbsTrust</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var run in Model.Runs)
                {
                    <tr>
                        <td>@run.ParameterValue.ToString("0.000")</td>
                        <td>@run.AverageTrust.ToString("0.00")</td>
                        <td>@run.AverageAbsTrust.ToString("0.00")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            if (typeof Chart === 'undefined') {
                return;
            }

            const trustPoints = @Html.Raw(Model.GetTrustChartJson());
            const emergentPoints = @Html.Raw(Model.GetEmergentChartJson());
            const trustDensityPoints = @Html.Raw(Model.GetTrustDensityChartJson());
            const linkPoints = @Html.Raw(Model.GetLinkChartJson());
            const phaseRatePoints = @Html.Raw(Model.GetPhaseRateChartJson());
            const serendipityPoints = @Html.Raw(Model.GetSerendipityChartJson());
            const knowledgePoints = @Html.Raw(Model.GetKnowledgeChartJson());
            const phaseScorePoints = @Html.Raw(Model.GetPhaseScoreChartJson());
            const pipelinePoints = @Html.Raw(Model.GetPipelineChartJson());
            const pipelineCompletionPoints = @Html.Raw(Model.GetPipelineCompletionChartJson());

            renderLineChart('averageAbsTrustChart', trustPoints, 'averageAbsTrust', '平均絶対信頼度', '#1c4b8f');
            renderLineChart('emergentCountChart', emergentPoints, 'emergentCount', '創発相到達数', '#2d7d46');
            renderDualLineChart('sweepTrustDensityChart', trustDensityPoints, [
                { key: 'averageTrust', label: 'Average Trust', color: '#1c4b8f' },
                { key: 'effectiveDensity', label: 'Effective Density', color: '#2d7d46' }
            ]);
            renderDualLineChart('sweepLinkChart', linkPoints, [
                { key: 'strongLinks', label: 'Strong Links', color: '#0d6efd' },
                { key: 'weakLinks', label: 'Weak Links', color: '#adb5bd' }
            ]);
            renderDualLineChart('sweepPhaseRateChart', phaseRatePoints, [
                { key: 'emergentRate', label: 'Emergent Rate', color: '#198754' },
                { key: 'stableRate', label: 'Stable Rate', color: '#0d6efd' },
                { key: 'learningRate', label: 'Learning Rate', color: '#6f42c1' },
                { key: 'siloRate', label: 'Silo Rate', color: '#dc3545' }
            ]);
            renderDualLineChart('sweepSerendipityChart', serendipityPoints, [
                { key: 'serendipityRate', label: 'Serendipity Rate', color: '#fd7e14' },
                { key: 'serendipityToEmergenceRate', label: 'Serendipity → Emergence', color: '#20c997' }
            ]);
            renderDualLineChart('sweepKnowledgeChart', knowledgePoints, [
                { key: 'averageKnowledgeDiversity', label: 'Average Knowledge Diversity', color: '#6f42c1' },
                { key: 'averageKnowledgeRecombinationScore', label: 'Average Knowledge Recombination', color: '#198754' },
                { key: 'averageKnowledgeReconfigurationScore', label: 'Average Knowledge Reconfiguration', color: '#0d6efd' }
            ]);
            renderDualLineChart('sweepPipelineChart', pipelinePoints, [
                { key: 'averageSerendipityScore', label: 'Serendipity', color: '#0f766e' },
                { key: 'averageKnowledgeRecombinationScore', label: 'Knowledge Recombination', color: '#d97706' },
                { key: 'averageKnowledgeReconfigurationScore', label: 'Knowledge Reconfiguration', color: '#7c3aed' },
                { key: 'averageLearningScore', label: 'Learning', color: '#2563eb' },
                { key: 'averageAdaptationScore', label: 'Adaptation', color: '#fd7e14' },
                { key: 'averageEmergentScore', label: 'Emergence', color: '#198754' }
            ]);
            renderLineChart('sweepPipelineCompletionChart', pipelineCompletionPoints, 'averagePipelineCompletionScore', 'Pipeline Completion', '#1c4b8f');
            renderDualLineChart('sweepPhaseScoreChart', phaseScorePoints, [
                { key: 'averageEmergentScore', label: 'Emergent Score', color: '#198754' },
                { key: 'averageStableScore', label: 'Stable Score', color: '#0d6efd' },
                { key: 'averageLearningScore', label: 'Learning Score', color: '#6f42c1' },
                { key: 'averageSiloScore', label: 'Silo Score', color: '#dc3545' },
                { key: 'averageAdaptationScore', label: 'Adaptation Score', color: '#fd7e14' }
            ]);

            function renderLineChart(canvasId, points, valueKey, label, color) {
                const canvas = document.getElementById(canvasId);
                if (!canvas || !points || points.length === 0) {
                    return;
                }

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: points.map(point => point.parameterValue),
                        datasets: [{
                            label,
                            data: points.map(point => point[valueKey]),
                            borderColor: color,
                            backgroundColor: `${color}22`,
                            fill: true,
                            tension: 0.2,
                            pointRadius: 4,
                            pointHoverRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true
                    }
                });
            }

            function renderDualLineChart(canvasId, points, series) {
                const canvas = document.getElementById(canvasId);
                if (!canvas || !points || points.length === 0) {
                    return;
                }

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: points.map(point => point.parameterValue),
                        datasets: series.map(item => ({
                            label: item.label,
                            data: points.map(point => point[item.key] ?? null),
                            borderColor: item.color,
                            backgroundColor: `${item.color}22`,
                            fill: false,
                            tension: 0.2,
                            pointRadius: 3,
                            pointHoverRadius: 4
                        }))
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        }
                    }
                });
            }
        })();
    </script>
}
