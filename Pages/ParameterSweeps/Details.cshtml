@page "{id:int}"
@model EmergentEngineering.Pages.ParameterSweeps.DetailsModel
@{
    ViewData["Title"] = Model.Sweep?.Name ?? "パラメータスイープ詳細";
    var phases = new[]
    {
        EmergentEngineering.Models.SimulationPhase.Forming,
        EmergentEngineering.Models.SimulationPhase.Learning,
        EmergentEngineering.Models.SimulationPhase.Stable,
        EmergentEngineering.Models.SimulationPhase.Emergent,
        EmergentEngineering.Models.SimulationPhase.Silo,
        EmergentEngineering.Models.SimulationPhase.Chaos,
        EmergentEngineering.Models.SimulationPhase.Collapse
    };
}

@if (Model.Sweep is null)
{
    <div class="alert alert-warning">パラメータスイープが見つかりません。</div>
    return;
}

<div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
        <a asp-page="/ParameterSweeps/Index" class="text-decoration-none small">&larr; パラメータスイープ一覧</a>
        <h1 class="h2 mt-2 mb-1">@Model.Sweep.Name</h1>
        <div class="text-muted">@Model.Sweep.Description</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-page="/ParameterSweeps/Run" asp-route-id="@Model.Sweep.Id">スイープ実行</a>
        @if (Model.Sweep.Status == EmergentEngineering.Models.ParameterSweepStatus.Running)
        {
            <form method="post" asp-page-handler="Stop" asp-route-id="@Model.Sweep.Id">
                <button type="submit" class="btn btn-outline-warning">スイープ停止</button>
            </form>
        }
        <a class="btn btn-outline-danger" asp-page="/ParameterSweeps/Delete" asp-route-id="@Model.Sweep.Id">削除</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SweepMessage))
{
    <div class="alert alert-info">@Model.SweepMessage</div>
}

<section class="summary-grid mb-4">
    <div><h2 class="h6">名前</h2><p>@Model.Sweep.Name</p></div>
    <div><h2 class="h6">基準シナリオ</h2><p>@Model.ScenarioName</p></div>
    <div><h2 class="h6">対象パラメータ</h2><p>@EmergentEngineering.Models.BoundaryParameterNames.GetLabel(Model.Sweep.TargetParameter)</p></div>
    <div><h2 class="h6">開始値</h2><p>@Model.Sweep.StartValue.ToString("0.000")</p></div>
    <div><h2 class="h6">終了値</h2><p>@Model.Sweep.EndValue.ToString("0.000")</p></div>
    <div><h2 class="h6">刻み幅</h2><p>@Model.Sweep.StepValue.ToString("0.000")</p></div>
    <div><h2 class="h6">各値の実行回数</h2><p>@Model.Sweep.RunCountPerValue</p></div>
    <div><h2 class="h6">エージェント数</h2><p>@Model.Sweep.AgentCount</p></div>
    <div><h2 class="h6">総ステップ数</h2><p>@Model.Sweep.TotalSteps</p></div>
    <div><h2 class="h6">LLMプロバイダー</h2><p>@Model.Sweep.LlmProvider</p></div>
    <div><h2 class="h6">LLMモデル</h2><p>@Model.Sweep.LlmModel</p></div>
    <div><h2 class="h6">状態</h2><p>@Model.FormatStatus(Model.Sweep.Status)</p></div>
</section>

<section class="summary-grid mb-4">
    <div><h2 class="h6">最大信頼</h2><p>@Model.MaxAverageTrustSummary</p></div>
    <div><h2 class="h6">最大実効密度</h2><p>@Model.MaxEffectiveDensitySummary</p></div>
    <div><h2 class="h6">最大創発率</h2><p>@Model.MaxEmergentRateSummary</p></div>
    <div><h2 class="h6">最大セレンディピティ率</h2><p>@Model.MaxSerendipityRateSummary</p></div>
    <div><h2 class="h6">最大信頼ジャンプ</h2><p>@Model.MaxTrustJumpSummary</p></div>
    <div><h2 class="h6">最大創発ジャンプ</h2><p>@Model.MaxEmergenceJumpSummary</p></div>
</section>

<section class="chart-panel mb-4">
    <h2 class="h5 mb-2">相転移分析グラフ</h2>
    <p class="text-muted mb-4">対象パラメータの変化に対して、信頼ネットワーク・セレンディピティ・創発相がどのように変化するかを比較します。</p>
    @if (Model.AnalysisPoints.Count == 0)
    {
        <p class="text-muted mb-0">まだ相転移分析用のデータはありません。</p>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-6">
                <h3 class="h6 mb-2">信頼と実効密度</h3>
                <canvas id="sweepTrustDensityChart" height="180"></canvas>
            </div>
            <div class="col-lg-6">
                <h3 class="h6 mb-2">Strong / Weak Links</h3>
                <canvas id="sweepLinkChart" height="180"></canvas>
            </div>
            <div class="col-lg-6">
                <h3 class="h6 mb-2">相到達率</h3>
                <canvas id="sweepPhaseRateChart" height="180"></canvas>
            </div>
            <div class="col-lg-6">
                <h3 class="h6 mb-2">セレンディピティと創発リンク</h3>
                <canvas id="sweepSerendipityChart" height="180"></canvas>
            </div>
        </div>
        <div class="row g-4 mt-4">
            <div class="col-12">
                <h3 class="h6 mb-2">知識多様性と再結合</h3>
                <canvas id="sweepKnowledgeChart" height="180"></canvas>
            </div>
        </div>
    }
</section>

<section class="chart-panel mb-4">
    <div class="row g-4">
        <div class="col-lg-6">
            <h2 class="h5 mb-3">パラメータ値ごとの平均絶対信頼度</h2>
            @if (Model.Runs.Count == 0)
            {
                <p class="text-muted mb-0">まだスイープ結果はありません。</p>
            }
            else
            {
                <canvas id="averageAbsTrustChart" height="180"></canvas>
            }
        </div>
        <div class="col-lg-6">
            <h2 class="h5 mb-3">パラメータ値ごとの創発相到達数</h2>
            @if (Model.Runs.Count == 0)
            {
                <p class="text-muted mb-0">まだスイープ結果はありません。</p>
            }
            else
            {
                <canvas id="emergentCountChart" height="180"></canvas>
            }
        </div>
    </div>
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Sweep結果一覧</h2>
    @if (Model.Runs.Count == 0)
    {
        <p class="text-muted mb-0">まだスイープ結果はありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>Experiment</th>
                        <th>FinalPhaseSummary</th>
                        <th>AverageTrust</th>
                        <th>AverageAbsTrust</th>
                        <th>CreatedAt</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var run in Model.Runs)
                {
                    <tr>
                        <td>@run.ParameterValue.ToString("0.000")</td>
                        <td><a asp-page="/Experiments/Details" asp-route-id="@run.ExperimentId">@Model.GetExperimentName(run.ExperimentId)</a></td>
                        <td>@Model.FormatPhaseSummary(run.FinalPhaseSummaryJson)</td>
                        <td>@run.AverageTrust.ToString("0.00")</td>
                        <td>@run.AverageAbsTrust.ToString("0.00")</td>
                        <td>@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">パラメータ差分分析</h2>
    <p class="text-muted">1つ前のパラメータ値と比較して、信頼・実効密度・創発率がどれだけ変化したかを確認します。</p>
    @if (Model.AnalysisPoints.Count == 0)
    {
        <p class="text-muted mb-0">まだ差分分析用のデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>AverageTrust</th>
                        <th>ΔTrust</th>
                        <th>EffectiveDensity</th>
                        <th>ΔEffectiveDensity</th>
                        <th>AverageKnowledgeDiversity</th>
                        <th>ΔKnowledgeDiversity</th>
                        <th>AverageKnowledgeRecombinationScore</th>
                        <th>ΔKnowledgeRecombination</th>
                        <th>AverageKnowledgeReconfigurationScore</th>
                        <th>ΔKnowledgeReconfiguration</th>
                        <th>EmergentRate</th>
                        <th>ΔEmergentRate</th>
                        <th>SerendipityRate</th>
                        <th>ΔSerendipityRate</th>
                        <th>StrongLinks</th>
                        <th>WeakLinks</th>
                        <th>ComponentCount</th>
                        <th>IsolatedAgents</th>
                        <th>相転移候補</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.AnalysisPoints)
                {
                    <tr class="@Model.GetTransitionRowClass(point)">
                        <td>@point.ParameterValue.ToString("0.000")</td>
                        <td>@point.AverageTrust.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaAverageTrust)</td>
                        <td>@point.EffectiveDensity.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaEffectiveDensity)</td>
                        <td>@point.AverageKnowledgeDiversity.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaKnowledgeDiversity)</td>
                        <td>@point.AverageKnowledgeRecombinationScore.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaKnowledgeRecombinationScore)</td>
                        <td>@point.AverageKnowledgeReconfigurationScore.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaKnowledgeReconfigurationScore)</td>
                        <td>@point.EmergentRate.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaEmergentRate)</td>
                        <td>@point.SerendipityRate.ToString("0.000")</td>
                        <td>@Model.FormatDelta(point.DeltaSerendipityRate)</td>
                        <td>@point.StrongLinks.ToString("0.00")</td>
                        <td>@point.WeakLinks.ToString("0.00")</td>
                        <td>@point.ComponentCount.ToString("0.00")</td>
                        <td>@point.IsolatedAgents.ToString("0.00")</td>
                        <td>@(string.IsNullOrWhiteSpace(point.TransitionCandidates) ? "-" : point.TransitionCandidates)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Emergent未達理由</h2>
    <p class="text-muted">1つ前のパラメータ値と比較して、どの条件が不足していたかを確認します。</p>
    @if (Model.AnalysisPoints.Count == 0)
    {
        <p class="text-muted mb-0">まだ未達理由の分析データはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>主な未達理由</th>
                        <th>信頼不足Run数</th>
                        <th>実効密度不足Run数</th>
                        <th>知識再結合不足Run数</th>
                        <th>セレンディピティ不足Run数</th>
                        <th>アイデア提案不足Run数</th>
                        <th>建設的批判不足Run数</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.AnalysisPoints)
                {
                    <tr>
                        <td>@point.ParameterValue.ToString("0.000")</td>
                        <td>@(string.IsNullOrWhiteSpace(point.MainEmergentFailureReason) ? "-" : point.MainEmergentFailureReason)</td>
                        <td>@point.TrustInsufficientRunCount</td>
                        <td>@point.EffectiveDensityInsufficientRunCount</td>
                        <td>@point.KnowledgeRecombinationInsufficientRunCount</td>
                        <td>@point.SerendipityInsufficientRunCount</td>
                        <td>@point.IdeaProposalInsufficientRunCount</td>
                        <td>@point.ConstructiveCriticismInsufficientRunCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <h2 class="h5 mb-3">Phase分布比較</h2>
    @if (Model.PhaseComparison.Count == 0)
    {
        <p class="text-muted mb-0">まだ Phase 分布比較データはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        @foreach (var phase in phases)
                        {
                            <th>@phase</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.PhaseComparison)
                {
                    <tr>
                        <td>@row.ParameterValue.ToString("0.000")</td>
                        @foreach (var phase in phases)
                        {
                            <td>@row.GetCount(phase)</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section">
    <h2 class="h5 mb-3">信頼度比較</h2>
    @if (Model.Runs.Count == 0)
    {
        <p class="text-muted mb-0">まだ信頼度比較データはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>ParameterValue</th>
                        <th>AverageTrust</th>
                        <th>AverageAbsTrust</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var run in Model.Runs)
                {
                    <tr>
                        <td>@run.ParameterValue.ToString("0.000")</td>
                        <td>@run.AverageTrust.ToString("0.00")</td>
                        <td>@run.AverageAbsTrust.ToString("0.00")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            if (typeof Chart === 'undefined') {
                return;
            }

            const trustPoints = @Html.Raw(Model.GetTrustChartJson());
            const emergentPoints = @Html.Raw(Model.GetEmergentChartJson());
            const trustDensityPoints = @Html.Raw(Model.GetTrustDensityChartJson());
            const linkPoints = @Html.Raw(Model.GetLinkChartJson());
            const phaseRatePoints = @Html.Raw(Model.GetPhaseRateChartJson());
            const serendipityPoints = @Html.Raw(Model.GetSerendipityChartJson());
            const knowledgePoints = @Html.Raw(Model.GetKnowledgeChartJson());

            renderLineChart('averageAbsTrustChart', trustPoints, 'averageAbsTrust', '平均絶対信頼度', '#1c4b8f');
            renderLineChart('emergentCountChart', emergentPoints, 'emergentCount', '創発相到達数', '#2d7d46');
            renderDualLineChart('sweepTrustDensityChart', trustDensityPoints, [
                { key: 'averageTrust', label: 'Average Trust', color: '#1c4b8f' },
                { key: 'effectiveDensity', label: 'Effective Density', color: '#2d7d46' }
            ]);
            renderDualLineChart('sweepLinkChart', linkPoints, [
                { key: 'strongLinks', label: 'Strong Links', color: '#0d6efd' },
                { key: 'weakLinks', label: 'Weak Links', color: '#adb5bd' }
            ]);
            renderDualLineChart('sweepPhaseRateChart', phaseRatePoints, [
                { key: 'emergentRate', label: 'Emergent Rate', color: '#198754' },
                { key: 'stableRate', label: 'Stable Rate', color: '#0d6efd' },
                { key: 'learningRate', label: 'Learning Rate', color: '#6f42c1' },
                { key: 'siloRate', label: 'Silo Rate', color: '#dc3545' }
            ]);
            renderDualLineChart('sweepSerendipityChart', serendipityPoints, [
                { key: 'serendipityRate', label: 'Serendipity Rate', color: '#fd7e14' },
                { key: 'serendipityToEmergenceRate', label: 'Serendipity → Emergence', color: '#20c997' }
            ]);
            renderDualLineChart('sweepKnowledgeChart', knowledgePoints, [
                { key: 'averageKnowledgeDiversity', label: 'Average Knowledge Diversity', color: '#6f42c1' },
                { key: 'averageKnowledgeRecombinationScore', label: 'Average Knowledge Recombination', color: '#198754' },
                { key: 'averageKnowledgeReconfigurationScore', label: 'Average Knowledge Reconfiguration', color: '#0d6efd' }
            ]);

            function renderLineChart(canvasId, points, valueKey, label, color) {
                const canvas = document.getElementById(canvasId);
                if (!canvas || !points || points.length === 0) {
                    return;
                }

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: points.map(point => point.parameterValue),
                        datasets: [{
                            label,
                            data: points.map(point => point[valueKey]),
                            borderColor: color,
                            backgroundColor: `${color}22`,
                            fill: true,
                            tension: 0.2,
                            pointRadius: 4,
                            pointHoverRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true
                    }
                });
            }

            function renderDualLineChart(canvasId, points, series) {
                const canvas = document.getElementById(canvasId);
                if (!canvas || !points || points.length === 0) {
                    return;
                }

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: points.map(point => point.parameterValue),
                        datasets: series.map(item => ({
                            label: item.label,
                            data: points.map(point => point[item.key] ?? null),
                            borderColor: item.color,
                            backgroundColor: `${item.color}22`,
                            fill: false,
                            tension: 0.2,
                            pointRadius: 3,
                            pointHoverRadius: 4
                        }))
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        }
                    }
                });
            }
        })();
    </script>
}
