<section class="log-section mb-4" id="researchPresetPanel" data-field-prefix="@fieldPrefix" data-id-prefix="@idPrefix" data-name-prefix="@namePrefix">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2 class="h5 mb-1">研究用プリセット</h2>
            <p class="text-muted small mb-0">研究目的に応じた初期パラメータを適用します。適用後も各項目は手動で調整できます。</p>
        </div>
    </div>
    <div class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="researchPresetSelect">プリセット</label>
            <select class="form-select" id="researchPresetSelect">
                <option value="">選択してください</option>
                <option value="standardMarketLearning">標準市場学習型</option>
                <option value="lowTrustLearning">低信頼・学習型</option>
                <option value="selectiveEmergence">選択的信頼・創発型</option>
                <option value="highTrustStall">高信頼・仲良し停滞型</option>
                <option value="dictatorSilo">独裁・サイロ型</option>
                <option value="ossReview">OSS・レビュー型</option>
                <option value="crisisAdaptation">危機対応・適応型</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-primary w-100" id="researchPresetApply">プリセット適用</button>
        </div>
    </div>
    <script>
        (() => {
            const panel = document.getElementById('researchPresetPanel');
            if (!panel) {
                return;
            }

            const presets = @Html.Raw(presetsJson);
            const presetSelect = panel.querySelector('#researchPresetSelect');
            const applyButton = panel.querySelector('#researchPresetApply');
            const idPrefix = panel.dataset.idPrefix || '';
            const namePrefix = panel.dataset.namePrefix || '';

            function resolveControl(fieldName) {
                return document.getElementById(idPrefix + fieldName)
                    || document.querySelector(`[name="${namePrefix}${fieldName}"]`);
            }

            function toFieldName(key) {
                if (!key || typeof key !== 'string') {
                    return key;
                }

                return key.charAt(0).toUpperCase() + key.slice(1);
            }

            function setValue(fieldName, value) {
                const control = resolveControl(fieldName);
                if (!control) {
                    return;
                }

                if (control.type === 'checkbox') {
                    control.checked = Boolean(value);
                } else {
                    control.value = String(value);
                }

                control.dispatchEvent(new Event('input', { bubbles: true }));
                control.dispatchEvent(new Event('change', { bubbles: true }));
            }

            function applyPreset() {
                const presetKey = presetSelect?.value;
                if (!presetKey || !presets[presetKey]) {
                    return;
                }

                const preset = presets[presetKey];
                Object.entries(preset).forEach(([key, value]) => setValue(toFieldName(key), value));
            }

            applyButton?.addEventListener('click', applyPreset);
        })();
    </script>
</section>
