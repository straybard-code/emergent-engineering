<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Emergence Engineering Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmergentEngineering.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index">Emergence Engineering Lab</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">シミュレーション</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Simulations/Create">新規シミュレーション</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Experiments/Index">実験</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Scenarios/Index">シナリオ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/ParameterSweeps/Index">パラメータスイープ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/PhaseDiagrams/Index">相図</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-shell">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Emergence Engineering Lab
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
