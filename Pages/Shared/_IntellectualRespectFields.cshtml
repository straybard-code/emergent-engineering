@model EmergentEngineering.Models.IIntellectualRespectSettings

<section class="log-section mb-4 optional-settings" data-optional-section="intellectual-respect">
    <h2 class="h5 mb-3">知的敬意 / Mutual Mentorship</h2>
    <p class="text-muted small mb-3">知的敬意は、相手の考え・経験・専門性に学ぶ価値を見いだす力です。どんな人でも師匠になり得るという前提で、知識再構成と創発を促進します。</p>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="form-check mt-4">
                <input asp-for="EnableIntellectualRespect" class="form-check-input" type="checkbox" />
                <label asp-for="EnableIntellectualRespect" class="form-check-label">知的敬意を有効化</label>
            </div>
            <span asp-validation-for="EnableIntellectualRespect" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IntellectualRespectBase" class="form-label">知的敬意ベース</label>
            <input asp-for="IntellectualRespectBase" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="IntellectualRespectBase" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IntellectualRespectGrowthRate" class="form-label">知的敬意成長率</label>
            <input asp-for="IntellectualRespectGrowthRate" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="IntellectualRespectGrowthRate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IntellectualRespectDecayRate" class="form-label">知的敬意減衰率</label>
            <input asp-for="IntellectualRespectDecayRate" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="IntellectualRespectDecayRate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IntellectualRespectDiversitySensitivity" class="form-label">異質知識尊重感度</label>
            <input asp-for="IntellectualRespectDiversitySensitivity" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="IntellectualRespectDiversitySensitivity" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IntellectualRespectChallengeSensitivity" class="form-label">異論知的敬意感度</label>
            <input asp-for="IntellectualRespectChallengeSensitivity" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="IntellectualRespectChallengeSensitivity" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IntellectualRespectMentorshipSensitivity" class="form-label">師匠化感度</label>
            <input asp-for="IntellectualRespectMentorshipSensitivity" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="IntellectualRespectMentorshipSensitivity" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IntellectualRespectEgoPenalty" class="form-label">自尊心ペナルティ</label>
            <input asp-for="IntellectualRespectEgoPenalty" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="IntellectualRespectEgoPenalty" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="IntellectualRespectHierarchyPenalty" class="form-label">序列ペナルティ</label>
            <input asp-for="IntellectualRespectHierarchyPenalty" class="form-control" type="number" min="0" max="1" step="0.001" />
            <span asp-validation-for="IntellectualRespectHierarchyPenalty" class="text-danger"></span>
        </div>
    </div>
</section>
