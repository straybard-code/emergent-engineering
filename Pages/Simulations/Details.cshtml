@page "{id:int}"
@model EmergentEngineering.Pages.Simulations.DetailsModel
@{
    ViewData["Title"] = Model.Project?.Name ?? "Simulation詳細";
}

@functions {
    private static string FormatPhase(string? phase) => phase switch
    {
        "Forming" => "Forming\uFF08\u5F62\u6210\u671F\uFF09",
        "Learning" => "Learning\uFF08\u5B66\u7FD2\u671F\uFF09",
        "Adaptation" => "Adaptation\uFF08\u9069\u5FDC\u671F\uFF09",
        "Stable" => "Stable\uFF08\u5B89\u5B9A\u671F\uFF09",
        "Emergent" => "Emergent\uFF08\u5275\u767A\u671F\uFF09",
        "Silo" => "Silo\uFF08\u30B5\u30A4\u30ED\u5316\uFF09",
        "Chaos" => "Chaos\uFF08\u6DF7\u4E71\uFF09",
        "Collapse" => "Collapse\uFF08\u5D29\u58CA\uFF09",
        _ => phase ?? "-"
    };

    private static string FormatStatus(string? status) => status switch
    {
        "Created" => "Created\uFF08\u4F5C\u6210\u6E08\u307F\uFF09",
        "Running" => "Running\uFF08\u5B9F\u884C\u4E2D\uFF09",
        "Failed" => "Failed\uFF08\u5931\u6557\uFF09",
        "Completed" => "Completed\uFF08\u5B8C\u4E86\uFF09",
        _ => status ?? "-"
    };

    private static string FormatMetric(double? value, string format = "0.00")
    {
        return value.HasValue ? value.Value.ToString(format) : "--";
    }

    private static string FormatMetric(int? value)
    {
        return value.HasValue ? value.Value.ToString() : "--";
    }

    private static string GetComponentBadgeClass(int? componentCount) => componentCount switch
    {
        >= 4 => "component-badge component-badge-danger",
        >= 2 => "component-badge component-badge-warning",
        _ => ""
    };

    private static string GetComponentBadgeText(int? componentCount) => componentCount switch
    {
        >= 4 => "ネットワーク分断",
        >= 2 => "サイロ形成",
        _ => ""
    };

    private static string GetThresholdSweepRowClass(int componentCount) => componentCount switch
    {
        >= 4 => "threshold-sweep-critical",
        >= 2 => "threshold-sweep-warning",
        _ => ""
    };

    private static string GetActionTimelineRowClass(bool phaseChanged)
    {
        return phaseChanged ? "phase-change-row" : "";
    }
}

@if (Model.Project is null)
{
    <div class="alert alert-warning">シミュレーションが見つかりません。</div>
    return;
}

<div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
        <a asp-page="/Index" class="text-decoration-none small">&larr; シミュレーション一覧</a>
        <h1 class="h2 mt-2 mb-1">@Model.Project.Name</h1>
        <div class="text-muted">現在ステップ @Model.Project.CurrentStep / @Model.Project.TotalSteps ・ 状態 @FormatStatus(Model.Project.Status) ・ 相 @FormatPhase(Model.Project.Phase)</div>
    </div>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="RunOne" asp-route-id="@Model.Project.Id">
            <button class="btn btn-primary" type="submit" disabled="@Model.IsCompleted">1ステップ実行</button>
        </form>
        <form method="post" asp-page-handler="RunAll" asp-route-id="@Model.Project.Id">
            <button class="btn btn-outline-primary" type="submit" disabled="@Model.IsCompleted">最後まで実行</button>
        </form>
        @if (Model.Project.Status == EmergentEngineering.Models.SimulationStatus.Running)
        {
            <form method="post" asp-page-handler="MarkFailed" asp-route-id="@Model.Project.Id">
                <button type="submit" class="btn btn-outline-secondary">失敗扱いにする</button>
            </form>
            <form method="post"
                  asp-page-handler="ForceDelete"
                  asp-route-id="@Model.Project.Id"
                  onsubmit="return confirm('実行中のデータを強制削除します。関連するStep、Action、TrustSnapshotも削除されます。よろしいですか？');">
                <button type="submit" class="btn btn-outline-danger">強制削除</button>
            </form>
        }
        @if (Model.Project.Status == EmergentEngineering.Models.SimulationStatus.Running)
        {
            <button type="button" class="btn btn-outline-danger" disabled>削除不可</button>
        }
        else
        {
            <a class="btn btn-outline-danger" asp-page="/Simulations/Delete" asp-route-id="@Model.Project.Id">シミュレーション削除</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SimulationMessage))
{
    <div class="alert alert-info">@Model.SimulationMessage</div>
}

@if (Model.Project.Status == EmergentEngineering.Models.SimulationStatus.Running)
{
    <div class="text-muted small mb-3">実行中のまま停止している場合のみ使用してください。</div>
}

<section class="summary-grid mb-4">
    <div>
        <h2 class="h6">現在ステップ</h2>
        <p>@Model.Project.CurrentStep / @Model.Project.TotalSteps</p>
    </div>
    <div>
        <h2 class="h6">状態</h2>
        <p>@FormatStatus(Model.Project.Status)</p>
    </div>
    <div>
        <h2 class="h6">相</h2>
        <p><span class="phase-pill">@FormatPhase(Model.Project.Phase)</span></p>
    </div>
    <div>
        <h2 class="h6">目的</h2>
        <p>@Model.Project.Purpose</p>
    </div>
    <div>
        <h2 class="h6">境界条件</h2>
        <p>@Model.Project.BoundaryConditions</p>
    </div>
    <div>
        <h2 class="h6">KPI</h2>
        <p>@Model.Project.KpiDefinition</p>
    </div>
    <div>
        <h2 class="h6">LLMプロバイダー</h2>
        <p>@Model.Project.LlmProvider</p>
    </div>
    <div>
        <h2 class="h6">LLMモデル</h2>
        <p>@Model.Project.LlmModel</p>
    </div>
</section>

<section class="log-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">Thanks Coin / 相互敬意分析</h2>
            <p class="text-muted small mb-0">支援・新しい視点・建設的異論・橋渡しへの感謝が、敬意・知識再構成・セレンディピティにどう作用したかを確認します。</p>
        </div>
    </div>
    @if (Model.KnowledgeTimeline.Count == 0)
    {
        <p class="text-muted mb-0">まだ Thanks Coin のタイムラインを表示できるデータはありません。</p>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm align-middle mb-0">
                <tbody>
                    <tr><th>Thanks発生数</th><td>@Model.KnowledgeTimeline.Sum(point => point.ThanksCoinCount)</td><th>Help / Idea / Challenge / Bridge</th><td>@($"{Model.KnowledgeTimeline.Sum(point => point.ThanksCoinHelpCount)} / {Model.KnowledgeTimeline.Sum(point => point.ThanksCoinIdeaCount)} / {Model.KnowledgeTimeline.Sum(point => point.ThanksCoinChallengeCount)} / {Model.KnowledgeTimeline.Sum(point => point.ThanksCoinBridgeCount)}")</td></tr>
                    <tr><th>AverageRespect</th><td>@Model.KnowledgeTimeline.Last().AverageRespect.ToString("0.000")</td><th>RespectDensity</th><td>@Model.KnowledgeTimeline.Last().RespectDensity.ToString("0.000")</td></tr>
                    <tr><th>RespectConcentration</th><td>@Model.KnowledgeTimeline.Last().RespectConcentration.ToString("0.000")</td><th>ThanksConcentration</th><td>@Model.KnowledgeTimeline.Last().ThanksConcentration.ToString("0.000")</td></tr>
                    <tr><th>ChallengeAcceptanceScore</th><td>@Model.KnowledgeTimeline.Last().ChallengeAcceptanceScore.ToString("0.000")</td><th>RespectReconfigurationBoost</th><td>@Model.KnowledgeTimeline.Last().RespectReconfigurationBoost.ToString("0.000")</td></tr>
                    <tr><th>RespectEmergenceComponent</th><td>@Model.KnowledgeTimeline.Last().RespectEmergenceComponent.ToString("0.000")</td><th>PopularityTrapPenalty</th><td>@Model.KnowledgeTimeline.Last().PopularityTrapPenalty.ToString("0.000")</td></tr>
                    <tr><th>Thanks→Reconfiguration</th><td>@Model.KnowledgeTimeline.Last().ThanksCoinToReconfigurationContribution.ToString("0.000")</td><th>Thanks→Serendipity</th><td>@Model.KnowledgeTimeline.Last().ThanksCoinToSerendipityContribution.ToString("0.000")</td></tr>
                    <tr><th>Thanks→Emergence</th><td>@Model.KnowledgeTimeline.Last().ThanksCoinToEmergenceContribution.ToString("0.000")</td><th>PopularityTrap</th><td>@(Model.KnowledgeTimeline.Last().PopularityTrapDetected ? "Yes" : "No")</td></tr>
                    <tr><th>ThanksCoinTrustDelta</th><td>@Model.KnowledgeTimeline.Sum(point => point.ThanksCoinTrustDelta).ToString("0.000")</td><th>ThanksCoinReconfigurationDelta</th><td>@Model.KnowledgeTimeline.Sum(point => point.ThanksCoinReconfigurationDelta).ToString("0.000")</td></tr>
                    <tr><th>ThanksCoinSerendipityDelta</th><td>@Model.KnowledgeTimeline.Sum(point => point.ThanksCoinSerendipityDelta).ToString("0.000")</td><th>ThanksCoinBridgeDelta</th><td>@Model.KnowledgeTimeline.Sum(point => point.ThanksCoinBridgeDelta).ToString("0.000")</td></tr>
                </tbody>
            </table>
        </div>
        <canvas id="thanksCoinTimelineChart" height="120" class="mb-4"></canvas>
        <canvas id="respectTimelineChart" height="120" class="mb-4"></canvas>
        <canvas id="thanksContributionChart" height="120"></canvas>
    }
</section>

<section class="log-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">Intellectual Respect / 知的敬意</h2>
            <p class="text-muted small mb-0">知的敬意は、相手の視点や専門性から学ぶ価値を見いだす度合いです。</p>
        </div>
    </div>
    @if (Model.KnowledgeTimeline.Count == 0)
    {
        <p class="text-muted mb-0">知的敬意のタイムラインを表示できるデータがまだありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Step</th>
                        <th>AverageIntellectualRespect</th>
                        <th>IntellectualRespectDensity</th>
                        <th>IntellectualRespectDiversityIndex</th>
                        <th>MutualMentorshipScore</th>
                        <th>IdeaAcceptanceScore</th>
                        <th>ChallengeAcceptanceScore</th>
                        <th>IntellectualRespectReconfigurationComponent</th>
                        <th>IntellectualRespectSerendipityComponent</th>
                        <th>IntellectualRespectEmergenceComponent</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.KnowledgeTimeline)
                {
                    <tr>
                        <td>@point.StepNo</td>
                        <td>@point.AverageIntellectualRespect.ToString("0.000")</td>
                        <td>@point.IntellectualRespectDensity.ToString("0.000")</td>
                        <td>@point.IntellectualRespectDiversityIndex.ToString("0.000")</td>
                        <td>@point.MutualMentorshipScore.ToString("0.000")</td>
                        <td>@point.IdeaAcceptanceScore.ToString("0.000")</td>
                        <td>@point.ChallengeAcceptanceScore.ToString("0.000")</td>
                        <td>@point.IntellectualRespectReconfigurationComponent.ToString("0.000")</td>
                        <td>@point.IntellectualRespectSerendipityComponent.ToString("0.000")</td>
                        <td>@point.IntellectualRespectEmergenceComponent.ToString("0.000")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">創発指紋</h2>
            <p class="text-muted small mb-0">この Run 全体の創発的振る舞いを特徴量ベクトルとして要約します。</p>
        </div>
    </div>
    @if (Model.Fingerprint is null)
    {
        <p class="text-muted mb-0">まだ創発指紋を計算できるデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <tbody>
                    <tr><th>FinalPhase</th><td>@FormatPhase(Model.Fingerprint.FinalPhase)</td><th>AverageTrust</th><td>@Model.Fingerprint.AverageTrust.ToString("0.00")</td></tr>
                    <tr><th>EffectiveDensity</th><td>@Model.Fingerprint.EffectiveDensity.ToString("0.000")</td><th>PhaseTransitionCount</th><td>@Model.Fingerprint.PhaseTransitionCount</td></tr>
                    <tr><th>PhaseStability</th><td>@Model.Fingerprint.PhaseStability.ToString("0.000")</td><th>ShareInfoRate</th><td>@Model.Fingerprint.ShareInfoRate.ToString("0.000")</td></tr>
                    <tr><th>WorkAloneRate</th><td>@Model.Fingerprint.WorkAloneRate.ToString("0.000")</td><th>TriggerAgentDiversity</th><td>@Model.Fingerprint.TriggerAgentDiversity</td></tr>
                    <tr><th>TopTriggerAgent</th><td>@Model.Fingerprint.TopTriggerAgentName (@Model.Fingerprint.TopTriggerAgentCount)</td><th>ThresholdFragilityScore</th><td>@Model.Fingerprint.ThresholdFragilityScore.ToString("0.000")</td></tr>
                    <tr><th>AverageKnowledgeStock</th><td>@Model.Fingerprint.AverageKnowledgeStock.ToString("0.000")</td><th>AverageKnowledgeDiversity</th><td>@Model.Fingerprint.AverageKnowledgeDiversity.ToString("0.000")</td></tr>
                    <tr><th>AverageExplorationScore</th><td>@Model.Fingerprint.AverageExplorationScore.ToString("0.000")</td><th>AverageSerendipityScore</th><td>@Model.Fingerprint.AverageSerendipityScore.ToString("0.000")</td></tr>
                    <tr><th>AverageKnowledgeRecombinationScore</th><td>@Model.Fingerprint.AverageKnowledgeRecombinationScore.ToString("0.000")</td><th>AverageKnowledgeReconfigurationScore</th><td>@Model.Fingerprint.AverageKnowledgeReconfigurationScore.ToString("0.000")</td></tr>
                    <tr><th>AverageTrustGrowthRateEffective</th><td>@Model.Fingerprint.AverageTrustGrowthRateEffective.ToString("0.000")</td><th>AverageTrustDecayApplied</th><td>@Model.Fingerprint.AverageTrustDecayApplied.ToString("0.000")</td></tr>
                    <tr><th>AverageTrustCapacityPenalty</th><td>@Model.Fingerprint.AverageTrustCapacityPenalty.ToString("0.000")</td><th>StrongTrustConcentration</th><td>@Model.Fingerprint.StrongTrustConcentration.ToString("0.000")</td></tr>
                    <tr><th>TrustCapacityExceededRate</th><td>@Model.Fingerprint.TrustCapacityExceededRate.ToString("0.000")</td><th>TrustNetworkType</th><td>@Model.Fingerprint.TrustNetworkType</td></tr>
                    <tr><th>SerendipityOccurredCount</th><td>@Model.Fingerprint.SerendipityOccurredCount</td><th>SerendipityRate</th><td>@Model.Fingerprint.SerendipityRate.ToString("0.000")</td></tr>
                    <tr><th>SerendipityToEmergenceLinkCount</th><td>@Model.Fingerprint.SerendipityToEmergenceLinkCount</td><th>SerendipityToEmergenceRate</th><td>@Model.Fingerprint.SerendipityToEmergenceRate.ToString("0.000")</td></tr>
                    <tr><th>MaxKnowledgeRewiringScore</th><td>@Model.Fingerprint.MaxKnowledgeRewiringScore.ToString("0.000")</td><th>FinalKnowledgeRewiringScore</th><td>@Model.Fingerprint.FinalKnowledgeRewiringScore.ToString("0.000")</td></tr>
                    <tr><th>ChallengeResolutionScore</th><td>@Model.Fingerprint.AverageChallengeResolutionScore.ToString("0.000")</td><th>ChallengeResolved</th><td>@(Model.Fingerprint.ChallengeResolved ? "Yes" : "No")</td></tr>
                    <tr><th>ShockOccurred</th><td>@(Model.Fingerprint.ShockOccurred ? "Yes" : "No")</td><th>ShockType</th><td>@Model.Fingerprint.ShockType</td></tr>
                    <tr><th>KnowledgeDrivenType</th><td>@Model.Fingerprint.KnowledgeDrivenType</td><th>TrustNetworkType</th><td>@Model.Fingerprint.TrustNetworkType</td></tr>
                    <tr><th>分類</th><td>@Model.Fingerprint.ClassificationLabel</td><th></th><td></td></tr>
                    <tr><th>ChallengeResolvedStep</th><td>@(Model.Fingerprint.ChallengeResolvedStep?.ToString() ?? "-")</td><th></th><td></td></tr>
                    <tr><th>AdaptationDuration</th><td>@Model.Fingerprint.AdaptationDuration</td><th>AverageChallengeGap</th><td>@Model.Fingerprint.AverageChallengeGap.ToString("0.000")</td></tr>
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4" id="phaseTransitionInspectorSection">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">相転移インスペクター</h2>
            <p class="text-muted small mb-0">相が変化したステップを抽出し、その前後の行動比率・信頼度・ネットワーク指標の変化を表示します。</p>
        </div>
    </div>
    @if (Model.PhaseTransitionInsights.Count == 0)
    {
        <p class="text-muted mb-0">まだ相転移は検出されていません。</p>
    }
    else
    {
        <section class="summary-grid mb-3">
            <div>
                <h2 class="h6">相転移回数</h2>
                <p>@Model.PhaseTransitionCount</p>
            </div>
            <div>
                <h2 class="h6">最初の相転移Step</h2>
                <p>@(Model.FirstPhaseTransitionStep?.ToString() ?? "-")</p>
            </div>
            <div>
                <h2 class="h6">最後の相転移Step</h2>
                <p>@(Model.LastPhaseTransitionStep?.ToString() ?? "-")</p>
            </div>
            <div>
                <h2 class="h6">最も多い遷移パターン</h2>
                <p>@Model.MostCommonPhaseTransitionPattern</p>
            </div>
        </section>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>ステップ</th>
                        <th>遷移元</th>
                        <th>遷移先</th>
                        <th>主な行動変化</th>
                        <th>主なネットワーク変化</th>
                        <th>解釈</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var insight in Model.PhaseTransitionInsights)
                {
                    <tr class="phase-change-row">
                        <td>@insight.StepNo</td>
                        <td><span class="phase-pill">@insight.FromPhaseLabel</span></td>
                        <td><span class="phase-pill">@insight.ToPhaseLabel</span></td>
                        <td>@insight.MainActionChange</td>
                        <td>@insight.MainNetworkChange</td>
                        <td>
                            <div>@insight.ExplainerText</div>
                            <div class="small text-muted mt-1">
                                情報共有 @Model.FormatSignedDelta(insight.ShareInfoDelta) /
                                単独作業 @Model.FormatSignedDelta(insight.WorkAloneDelta) /
                                支援 @Model.FormatSignedDelta(insight.SupportOtherDelta) /
                                実効密度 @Model.FormatSignedDelta(insight.EffectiveDensityDelta) /
                                平均信頼度 @Model.FormatSignedDelta(insight.AverageTrustDelta)
                            </div>
                            @if (insight.ChallengeOccurred || insight.ChallengeActive || insight.ChallengeResolved)
                            {
                                <div class="small text-muted mt-1">
                                    Challenge active: @(insight.ChallengeActive ? "Yes" : "No") /
                                    Resolution: @insight.ChallengeResolutionScore.ToString("0.00") /
                                    Gap: @insight.ChallengeGap.ToString("0.00") /
                                    Reconfiguration: @insight.KnowledgeReconfigurationScore.ToString("0.00")
                                </div>
                            }
                            <details class="mt-2">
                                <summary class="small text-primary">詳細を見る</summary>
                                <div class="small mt-2"><strong>主な増加Action:</strong> @insight.MainIncreasingAction</div>
                                <div class="small"><strong>主な減少Action:</strong> @insight.MainDecreasingAction</div>
                                <div class="small mb-2"><strong>Window内で最も多かったAction:</strong> @insight.WindowDominantAction</div>

                                <div class="fw-semibold small mt-2">Trigger Agent / 引き金エージェント</div>
                                @if (insight.TriggerAgents.Count == 0)
                                {
                                    <div class="small text-muted mb-2">該当なし</div>
                                }
                                else
                                {
                                    <div class="table-responsive mb-2">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Agent</th>
                                                    <th>TriggerScore</th>
                                                    <th>主なAction</th>
                                                    <th>TrustDeltaSum</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var agent in insight.TriggerAgents)
                                            {
                                                <tr>
                                                    <td>@agent.AgentName</td>
                                                    <td>@agent.TriggerScore.ToString("0.00")</td>
                                                    <td>@agent.MainAction</td>
                                                    <td>@Model.FormatSignedDelta(agent.TrustDeltaSum)</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <div class="fw-semibold small mt-2">Trigger Trust Changes / 信頼変化</div>
                                @if (insight.TriggerTrustChanges.Count == 0)
                                {
                                    <div class="small text-muted mb-2">該当なし</div>
                                }
                                else
                                {
                                    <div class="table-responsive mb-2">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Step</th>
                                                    <th>Agent</th>
                                                    <th>Action</th>
                                                    <th>Target</th>
                                                    <th>ΔTrust</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var trust in insight.TriggerTrustChanges)
                                            {
                                                <tr>
                                                    <td>@trust.StepNo</td>
                                                    <td>@trust.AgentName</td>
                                                    <td>@trust.Action</td>
                                                    <td>@trust.TargetAgentName</td>
                                                    <td>@Model.FormatSignedDelta(trust.TrustDelta)</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <div class="fw-semibold small mt-2">Trigger Edges / 強リンク変化</div>
                                <div class="small"><strong>New Strong Links:</strong> @insight.NewStrongLinkTotalCount 件</div>
                                @if (insight.NewStrongLinks.Count == 0)
                                {
                                    <div class="small text-muted mb-2">該当なし</div>
                                }
                                else
                                {
                                    <ul class="small mb-2">
                                    @foreach (var edge in insight.NewStrongLinks)
                                    {
                                        <li>@edge.SourceAgentName &rarr; @edge.TargetAgentName : @edge.BeforeValue.ToString("0.00") &rarr; @edge.AfterValue.ToString("0.00")</li>
                                    }
                                    </ul>
                                }

                                <div class="small"><strong>Lost Strong Links:</strong> @insight.LostStrongLinkTotalCount 件</div>
                                @if (insight.LostStrongLinks.Count == 0)
                                {
                                    <div class="small text-muted">該当なし</div>
                                }
                                else
                                {
                                    <ul class="small mb-0">
                                    @foreach (var edge in insight.LostStrongLinks)
                                    {
                                        <li>@edge.SourceAgentName &rarr; @edge.TargetAgentName : @edge.BeforeValue.ToString("0.00") &rarr; @edge.AfterValue.ToString("0.00")</li>
                                    }
                                    </ul>
                                }
                            </details>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4" id="precursorSection">
