            <p class="text-muted small mb-0">各Stepにおける Emergent / Stable / Learning などの判定スコアを比較します。</p>
        </div>
    </div>
    @if (Model.KnowledgeTimeline.Count == 0)
    {
        <p class="text-muted mb-0">まだ phase score を表示できるデータはありません。</p>
    }
    else
    {
        <canvas id="phaseScoreChart" height="120"></canvas>
    }
</section>

<section class="log-section mb-4" id="phaseDecisionSection">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">Phase 判定内訳</h2>
            <p class="text-muted small mb-0">各Stepでどの相に判定されたか、また Emergent / Stable / Learning などのスコアと判定理由を表示します。</p>
        </div>
    </div>
    @if (Model.KnowledgeTimeline.Count == 0)
    {
        <p class="text-muted mb-0">まだ Phase 判定内訳を表示できるデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Step</th>
                        <th>Phase</th>
                        <th>Decision</th>
                        <th>Emergent</th>
                        <th>Stable</th>
                        <th>Learning</th>
                        <th>Silo</th>
                        <th>Chaos</th>
                        <th>Collapse</th>
                        <th>判定理由</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.KnowledgeTimeline)
                {
                    <tr>
                        <td>@point.StepNo</td>
                        <td><span class="phase-pill">@FormatPhase(point.Phase)</span></td>
                        <td>@point.PhaseDecisionScore.ToString("0.000")</td>
                        <td>@point.EmergentScore.ToString("0.000")</td>
                        <td>@point.StableScore.ToString("0.000")</td>
                        <td>@point.LearningScore.ToString("0.000")</td>
                        <td>@point.SiloScore.ToString("0.000")</td>
                        <td>@point.ChaosScore.ToString("0.000")</td>
                        <td>@point.CollapseScore.ToString("0.000")</td>
                        <td>
                            @Model.GetPhaseDecisionReason(point)
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="log-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 mb-1">Emergent 判定内訳</h2>
            <p class="text-muted small mb-0">最終Stepで、創発期に必要な条件を満たしているかを表示します。</p>
        </div>
    </div>
    @if (Model.FinalEmergentCriteria.Count == 0)
    {
        <p class="text-muted mb-0">まだ Emergent 判定内訳を表示できるデータはありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>条件</th>
                        <th>値</th>
                        <th>閾値</th>
