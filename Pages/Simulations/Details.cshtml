<ul class="nav nav-tabs mb-3" id="simulationTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.SelectedView == "logs" ? "active" : "")" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logs" type="button" role="tab">実行ログ</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="agents-tab" data-bs-toggle="tab" data-bs-target="#agents" type="button" role="tab">エージェント</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.SelectedView == "history" ? "active" : "")" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">エージェント履歴</button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade @(Model.SelectedView == "logs" ? "show active" : "")" id="logs" role="tabpanel" aria-labelledby="logs-tab">
        <form method="get" class="log-filter mb-3">
            <div>
                <input type="hidden" name="id" value="@Model.Project.Id" />
                <input type="hidden" name="view" value="logs" />
                <label class="form-label" for="agentId">Agent Filter</label>
                <select class="form-select" id="agentId" name="agentId">
                    <option value="">All Agents</option>
                    @foreach (var agent in Model.Project.Agents.OrderBy(agent => agent.Id))
                    {
                        <option value="@agent.Id" selected="@(Model.SelectedAgentId == agent.Id ? "selected" : null)">@agent.Name - @agent.Role</option>
                    }
                </select>
            </div>
            <button class="btn btn-outline-primary" type="submit">適用</button>
        </form>

        @if (Model.Actions.Count == 0)
        {
            <div class="empty-state">
                <h2 class="h5">実行ログはまだありません</h2>
                <p>1ステップ実行すると message, memory, action, target が保存されます。</p>
            </div>
        }
        else
        {
            <section class="log-section">
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Step</th>
                                <th>Agent</th>
                                <th>Action</th>
                                <th>Target</th>
                                <th>Message</th>
                                <th>Memory</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var action in Model.Actions)
                        {
                            <tr>
                                <td>@action.StepNo</td>
                                <td>@action.Agent?.Name</td>
                                <td><span class="action-chip @Model.GetActionCssClass(action.Action)">@action.Action</span></td>
                                <td>@(string.IsNullOrWhiteSpace(action.TargetAgentName) ? "-" : action.TargetAgentName)</td>
                                <td>@action.Message</td>
                                <td>@action.Memory</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>

    <div class="tab-pane fade" id="agents" role="tabpanel" aria-labelledby="agents-tab">
        <div class="row g-3">
        @foreach (var agent in Model.Project.Agents.OrderBy(agent => agent.Id))
        {
            <div class="col-md-6">
                <article class="agent-card">
                    <div class="d-flex justify-content-between">
                        <h2 class="h5">@agent.Name</h2>
                        <span class="badge text-bg-light">@agent.Role</span>
                    </div>
                    <dl class="row small mb-3">
                        <dt class="col-4">Personality</dt>
                        <dd class="col-8">@agent.Personality</dd>
                        <dt class="col-4">Orientation</dt>
                        <dd class="col-8">@agent.Orientation</dd>
                        <dt class="col-4">Position</dt>
                        <dd class="col-8">@agent.PositionX, @agent.PositionY</dd>
                    </dl>
                    <p class="mb-2">@agent.Memory</p>
                    <div class="small"><strong>TrustJson:</strong> <code>@agent.TrustJson</code></div>
                    <a class="btn btn-sm btn-outline-secondary mt-3" asp-page="/Simulations/Details" asp-route-id="@Model.Project.Id" asp-route-agentId="@agent.Id" asp-route-view="history">履歴を見る</a>
                </article>
            </div>
        }
        </div>
    </div>

    <div class="tab-pane fade @(Model.SelectedView == "history" ? "show active" : "")" id="history" role="tabpanel" aria-labelledby="history-tab">
        <form method="get" class="d-flex gap-2 align-items-end mb-3">
            <div>
                <input type="hidden" name="id" value="@Model.Project.Id" />
                <input type="hidden" name="view" value="history" />
                <label class="form-label" for="historyAgentId">Agent</label>
                <select class="form-select" id="historyAgentId" name="agentId">
                    <option value="">Select an Agent</option>
                    @foreach (var agent in Model.Project.Agents.OrderBy(agent => agent.Id))
                    {
                        <option value="@agent.Id" selected="@(Model.SelectedAgentId == agent.Id ? "selected" : null)">@agent.Name - @agent.Role</option>
                    }
                </select>
            </div>
            <button class="btn btn-outline-primary" type="submit">表示</button>
        </form>

        @if (Model.SelectedAgentId is null)
        {
            <p class="text-muted">履歴を確認する Agent を選択してください。</p>
        }
        else if (Model.AgentHistory.Count == 0)
        {
            <p class="text-muted">この Agent の履歴はまだありません。</p>
        }
        else
        {
            if (Model.SelectedAgent is not null)
            {
                <section class="log-section mb-3">
                    <div class="row g-3 small">
                        <div class="col-md-3"><strong>Agent:</strong> @Model.SelectedAgent.Name</div>
                        <div class="col-md-3"><strong>Role:</strong> @Model.SelectedAgent.Role</div>
                        <div class="col-md-3"><strong>Personality:</strong> @Model.SelectedAgent.Personality</div>
                        <div class="col-md-3"><strong>Orientation:</strong> @Model.SelectedAgent.Orientation</div>
                    </div>
                </section>
            }

            <div class="timeline">
            @foreach (var action in Model.AgentHistory)
            {
                <article class="timeline-item">
                    <div class="small text-muted">Step @action.StepNo ・ <span class="action-chip @Model.GetActionCssClass(action.Action)">@action.Action</span></div>
                    <h2 class="h6">@action.Agent?.Name</h2>
                    <p>@action.Message</p>
                    <p class="small"><strong>Memory:</strong> @action.Memory</p>
                </article>
            }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            const phasePoints = @Html.Raw(Model.GetPhaseHistoryJson());
            const networkSnapshots = @Html.Raw(Model.GetNetworkSnapshotsJson());
            const thresholdSweep = @Html.Raw(Model.GetThresholdSweepJson());
            const actionTimeline = @Html.Raw(Model.GetActionTimelineJson());
            const precursorPoints = @Html.Raw(Model.GetPrecursorPointsJson());
            const knowledgeTimeline = @Html.Raw(Model.GetKnowledgeTimelineJson());
            const pipelineTimeline = @Html.Raw(Model.GetPipelineTimelineJson());
            const phaseScorePoints = @Html.Raw(Model.GetPhaseScoreTimelineJson());
            const thanksCoinPoints = @Html.Raw(Model.GetThanksCoinTimelineJson());

            renderPhaseTimeline(phasePoints);
            arrangeAnalysisSections();
            renderPrecursorChart(precursorPoints);
            renderKnowledgeTimeline(knowledgeTimeline);
            renderPipelineTimeline(pipelineTimeline);
            renderPipelineCompletionTimeline(pipelineTimeline);
            renderPhaseScoreTimeline(phaseScorePoints);
            renderThanksCoinTimeline(thanksCoinPoints);
            renderRespectTimeline(thanksCoinPoints);
            renderThanksContributionTimeline(thanksCoinPoints);
            renderSerendipityTimeline(knowledgeTimeline);
            renderActionTimeline(actionTimeline);
            renderThresholdSweep(thresholdSweep);
            renderTrustNetwork(networkSnapshots);

            function renderPhaseTimeline(points) {
                const canvas = document.getElementById('phaseTimelineChart');
                if (!canvas || !points || points.length === 0 || typeof Chart === 'undefined') {
                    return;
                }

                const phaseLabels = {
                    '-3': 'Collapse',
                    '-2': 'Chaos',
                    '-1': 'Silo',
                    '0': 'Forming',
                    '1': 'Learning',
                    '2': 'Adaptation',
                    '3': 'Stable',
                    '4': 'Emergent'
                };

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: points.map(point => point.stepNo),
                        datasets: [{
                            label: 'Phase',
                            data: points.map(point => point.phaseValue),
                            borderColor: '#1c4b8f',
                            backgroundColor: 'rgba(28, 75, 143, 0.14)',
                            tension: 0.2,
                            fill: true,
                            pointRadius: 4,
                            pointHoverRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        scales: {
                            y: {
                                min: -3,
                                max: 3,
                                ticks: {
                                    stepSize: 1,
                                    callback: value => phaseLabels[String(value)] ?? value
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'Step'
                                }
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: context => {
                                        const point = points[context.dataIndex];
                                        return ` ${point.phase} (${point.phaseValue})`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            function renderActionTimeline(points) {
                const canvas = document.getElementById('actionTimelineChart');
                if (!canvas || !points || points.length === 0 || typeof Chart === 'undefined') {
                    return;
                }

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: points.map(point => point.stepNo),
                        datasets: [
                            buildRateDataset('情報共有', points.map(point => point.shareInfoRate), '#2563eb'),
                            buildRateDataset('相談', points.map(point => point.askHelpRate), '#2f855a'),
                            buildRateDataset('アイデア提案', points.map(point => point.proposeIdeaRate), '#d97706'),
                            buildRateDataset('批判', points.map(point => point.criticizeRate), '#c2410c'),
                            buildRateDataset('単独作業', points.map(point => point.workAloneRate), '#6b7280'),
                            buildRateDataset('支援', points.map(point => point.supportOtherRate), '#0f766e'),
                            buildRateDataset('待機', points.map(point => point.waitRate), '#7c3aed')
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            x: {
                                title: {
                                    display: true,
                                    text: 'Step'
                                }
                            },
                            y: {
                                beginAtZero: true,
                                max: 1,
                                ticks: {
                                    callback: value => Number(value).toFixed(2)
                                }
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    afterTitle: items => {
                                        const point = points[items[0].dataIndex];
                                        return `Phase: ${point.phase}`;
                                    },
                                    label: context => `${context.dataset.label}: ${Number(context.parsed.y).toFixed(2)}`
                                }
                            }
                        }
                    }
                });
            }

            function renderPrecursorChart(points) {
                const canvas = document.getElementById('precursorChart');
                if (!canvas || !points || points.length === 0 || typeof Chart === 'undefined') {
                    return;
                }

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: points.map(point => point.stepNo),
                        datasets: [
                            buildRateDataset('Silo Risk', points.map(point => point.siloRiskScore), '#b45309'),
                            buildRateDataset('Stable', points.map(point => point.stableScore), '#2563eb'),
                            buildRateDataset('Emergent', points.map(point => point.emergentScore), '#0f766e')
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            x: {
                                title: {
                                    display: true,
                                    text: 'Step'
                                }
