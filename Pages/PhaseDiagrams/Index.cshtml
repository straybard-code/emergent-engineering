@page
@model EmergentEngineering.Pages.PhaseDiagrams.IndexModel
@{
    ViewData["Title"] = "創発相図";
}

@functions {
    private static string GetStatusText(string? status) => status switch
    {
        "Created" => "Created（作成済み）",
        "Pending" => "Pending（待機中）",
        "Running" => "Running（実行中）",
        "Completed" => "Completed（完了）",
        "Failed" => "Failed（失敗）",
        _ => status ?? "-"
    };

    private static string GetStatusBadgeClass(string? status) => status switch
    {
        "Running" => "status-badge status-running",
        "Completed" => "status-badge status-completed",
        "Failed" => "status-badge status-failed",
        _ => "status-badge status-pending"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h2 mb-1">創発相図</h1>
        <p class="text-muted mb-0">2つのパラメータを同時に変化させ、Learning / Stable / Emergent / Silo の相領域を可視化します。</p>
    </div>
    <a class="btn btn-primary" asp-page="/PhaseDiagrams/Create">新規相図</a>
</div>

@if (Model.Diagrams.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">創発相図はまだありません</h2>
        <p>Scenario を基準にして X/Y 軸パラメータを選び、2次元の相図として結果を比較できます。</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>名前</th>
                    <th>基準シナリオ</th>
                    <th>Adaptive</th>
                    <th>親相図</th>
                    <th>X軸</th>
                    <th>Y軸</th>
                    <th>グリッド点数</th>
                    <th>状態</th>
                    <th>作成日時</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var diagram in Model.Diagrams)
            {
                <tr>
                    <td><strong>@diagram.Name</strong></td>
                    <td>@diagram.ScenarioName</td>
                    <td>@(diagram.IsAdaptiveSweep ? "Yes" : "No")</td>
                    <td>
                        @if (diagram.ParentPhaseDiagramId.HasValue)
                        {
                            <a asp-page="/PhaseDiagrams/Details" asp-route-id="@diagram.ParentPhaseDiagramId.Value">@diagram.ParentPhaseDiagramName</a>
                        }
                        else
                        {
                            <span class="text-muted">--</span>
                        }
                    </td>
                    <td>@diagram.XAxisLabel</td>
                    <td>@diagram.YAxisLabel</td>
                    <td>@diagram.GridPointCount</td>
                    <td><span class="@GetStatusBadgeClass(diagram.Status)">@GetStatusText(diagram.Status)</span></td>
                    <td>@diagram.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/PhaseDiagrams/Details" asp-route-id="@diagram.Id">詳細</a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="/PhaseDiagrams/Delete" asp-route-id="@diagram.Id">削除</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
